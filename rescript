        latest_snapshot=$(restic snapshots --compact --host "$(hostname)" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot"
        time-end
      fi
      exit
      ;;
  esac
}

function cleanup {
  rescript-lock
  if [[ "$flags" ]] ; then
    case "$flags" in
      -a|--archive)
        if [[ ! -z "${policies[*]}" ]] ; then
          time-start
          rm -rf "$lock"
          archive
          restic forget "${policies[@]}"
          restic prune --cleanup-cache
          if [[ -f "$config_dir/$repo-datefile" || "$CLEAN" -gt "0" ]] ; then
            cleanup-next
          fi
          time-end
          exit
        else
          echo -e "$yellow""You have not indicated any policy value...""$endcolor"
          echo "If you want to use [cleanup] option you need to set the [KEEP] variables."
          echo "For more information about the Usage check out the following link:"
          echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
          exit
        fi
        ;;
      -d|--dry-run)
        echo "This is just a test..."
        printf "%$((80/1))s\n" "" | tr ' ' -
        restic forget "${policies[@]}" --dry-run
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo "Using [--dry-run] flag does not remove anything."
        exit
        ;;
      -e|--exec)
        if [[ ! "${opt[*]}" ]] ; then
          echo "[$flags] needs an argument..."
          echo ""
          cleanup-help
          exit
        else
          time-start
          restic forget "${policies[@]}" "${opt[@]}"
          restic prune --cleanup-cache
          time-end
          exit
        fi
        ;;
      -h|--help)
        cleanup-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      -n|--next)
        if [[ -z "$CLEAN" || "$CLEAN" -lt "1" ]] ; then
          echo -e "$yellow""You have not indicated any policy for the CLEAN value...""$endcolor"
          echo "The scrip will run check, forget and prune every time it runs"
          echo "unless you change the CLEAN variable at the beginning of this script."
          echo "The number indicated in the CLEAN variable must be in days."
          echo "For more information about the usage check out the following link:"
          echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
          exit
        else
          cleanup-next
          exit
        fi
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        cleanup-help
        exit
        ;;
    esac
  fi
  if [[ ! -z "${policies[*]}" ]] ; then
    time-start
    restic forget "${policies[@]}"
    restic prune --cleanup-cache
    if [[ -f "$config_dir/$repo-datefile" || "$CLEAN" -gt "0" ]] ; then
      cleanup-next
    fi
    time-end
  else
    echo -e "$yellow""You have not indicated any policy value...""$endcolor"
    echo "If you want to use [cleanup] option you need to set the [KEEP] variables."
    echo "For more information about the Usage check out the following link:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function cleanup-next {
  if [[ ! -f "$config_dir/$repo-datefile" ]] ; then
    touch "$config_dir/$repo-datefile"
  fi
  now_next
  result=$((next-now))
  days=$((result / 86400))
  hours=$(((result / 3600) % 24))
  minutes=$(((result / 60) % 60))
  if [[ "$days" = "1" ]] ; then
    d="day"
  else
    d="days"
  fi
  if [[ "$hours" = "1" ]] ; then
    h="hour"
  else
    h="hours"
  fi
  if [[ "$minutes" = "1" ]] ; then
    m="minute"
  else
    m="minutes"
  fi
  if [[ "$days" -gt "0" ]] ; then
    if [[ "$hours" -gt "0" ]] ; then
        if [[ "$minutes" -gt "0" ]] ; then
          echo -e "$yellow""Next cleanup and check in $days $d, $hours $h and $minutes $m...""$endcolor"
        else
          echo -e "$yellow""Next cleanup and check in $days $d and $hours $h...""$endcolor"
        fi
    elif [[ "$minutes" -gt "0" ]] ; then
      echo -e "$yellow""Next cleanup and check in $days $d and $minutes $m...""$endcolor"
    else
      echo -e "$yellow""Next cleanup and check in $days $d...""$endcolor"
    fi
  elif [[ "$hours" -gt "0" ]] ; then
    if [[ "$minutes" -gt "0" ]] ; then
      echo -e "$yellow""Next cleanup and check in $hours $h and $minutes $m...""$endcolor"
    else
      echo -e "$yellow""Next cleanup and check in $hours $h...""$endcolor"
    fi
  elif [[ "$minutes" -gt "0" ]] ; then
    echo -e "$yellow""Next cleanup and check in $minutes $m...""$endcolor"
  else
    echo -e "$yellow""Repo will be cleaned and checked in the next run...""$endcolor"
  fi
}

function env-conf {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        env-help
        exit
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        env-help
        exit
        ;;
    esac
  else
    sed '/^#/ d' < "$config_dir/$repo.conf" | sed '/^\s*$/d'
  fi
}

function logs {
  shopt -u nocasematch
  if [[ ! "$flags" ]] ; then
    echo "You have not indicated any option."
    echo ""
    logs-help
    exit
  fi
  case "$flags" in
    -c|--cat)
      if [[ "$logfile" ]] ; then
        cat "$logs_dir/$logfile"
      else
        echo "No log file indicated..."
        exit
      fi
      ;;
    -h|--help)
      logs-help
      exit
      ;;
    -L|--list)
      if ls "$logs_dir/$repo"-* 1> /dev/null 2>&1 ; then
        ls $logs_dir/ | grep -e "$repo"
        echo ""
        echo "Your logs are saved at $logs_dir"
      else
        echo "There are no log files to list for [$repo]."
      fi
      ;;
    -r|--remove)
      if ls "$logs_dir/$repo"-* 1> /dev/null 2>&1 ; then
        rm -rf "$logs_dir/$repo"-*
        echo "Log files removed for [$repo]."
      else
        echo "There are no log files to remove for [$repo]." 
      fi
      ;;
    *)
      echo "Invalid flag [$flags]..."
      echo ""
      logs-help
      exit
      ;;
  esac
}

function logger {
  if [[ ! "$cmd" ]] ; then
    log="$logs_dir/$repo-log-$(date +%Y-%m-%d-%H:%M).log"
  else
    log="$logs_dir/$repo-$cmd-log-$(date +%Y-%m-%d-%H:%M).log"
  fi
  exec > >(tee -a "$log") 2>&1
}

function mounter {
  rescript-lock
  if [[ "$flags" ]] ; then
    case "$flags" in
      -e|--exec)
        mkdir "$rmount"
        restic mount "$rmount" ${opt[@]}
        rm -rf "$rmount"
        exit
        ;;
      -h|--help)
        mounter-help
        exit
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        mounter-help
        exit
        ;;
    esac
  fi
  mkdir "$rmount"
  restic mount "$rmount"
  rm -rf "$rmount"
}

function now_next {
  case "$(uname -s)" in
    Linux|GNU)
      now=$(date +"%s")
      next=$(date -f "$config_dir/$repo-datefile" "+%s")
      ;;
    *)
      now=$(gdate +"%s")
      next=$(gdate -f "$config_dir/$repo-datefile" "+%s")
      ;;
  esac
}

function random-check {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        random-check-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        random-check-help
        exit
        ;;
    esac
  fi
  rescript-lock
  time-start
  restic check --read-data-subset $((RANDOM % 10 + 1))/10
  time-end
}

function rescript-lock {
  if [ -e "$lock" ]; then
    echo "WARNING: [$repo] repo is already running..."
    echo "If you are sure $repo is not running, type"
    echo " "
    echo "  rescript $repo unlocker"
    echo " "
    echo "This will remove the lock for [$repo] repository."
    echo ""
    echo "Lock file info:"
    stat "$lock_dir/$repo.lock"
    exit
  fi
  touch "$lock"
  trap 'rm -rf "$lock"' INT QUIT TERM EXIT
}

function restorer {
  shopt -u nocasematch
  rescript-lock
  if [[ "$logger" ]] ; then
    case "$logger" in
      -l|--log)
        echo "You must use [$logger] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      *)
        echo "Invalid flag [$logger]..."
        echo ""
        restorer-help
        exit
        ;;
    esac
  fi
  if [[ ! "$flags" ]] ; then
    echo "You have not indicated any option..."
    echo ""
    restorer-help
    exit
  fi
  case "$flags" in
    -h|--help)
      restorer-help
      exit
      ;;
    -H|--host)
      restic_restore="$HOME/restore-latest-host-"$hpts"_$(date +%s)"
      ;;
    -l|--log)
      echo "You must use [$flags] only before any other command."
      echo ""
      logger-help
      exit
      ;;
    -p|--path)
      restic_restore="$HOME/restore-latest-by-path_$(date +%s)"
      ;;
    -T|--tag)
      restic_restore="$HOME/restore-latest-tag-"$hpts"_$(date +%s)"
      ;;
    *)
      restic_restore="$HOME/restore-ID-"$hpts"_$(date +%s)"
      ;;
  esac
  case "$flags" in
    -H|--host|-p|--path|-T|--tag)
      if [[ ! "$hpts" ]] ; then
        if [[ "$flags" = "--host" || "$flags" = "-H" ]] ; then
          echo "No [host] indicated..."
          echo ""
          restorer-help
          exit
        elif [[ "$flags" = "--path" || "$flags" = "-p" ]] ; then
          echo "No [path] indicated..."
          echo ""
          restorer-help
          exit
        elif [[ "$flags" = "--tag" || "$flags" = "-t" ]] ; then
          echo "No [tag] indicated..."
          echo ""
          restorer-help
          exit
        fi
      fi      
      time-start
      if [[ "$DESTINATION" ]] ; then
        echo -e "$yellow""Restoring latest snapshot for [$hpts] from:""$endcolor" "$DESTINATION..."
      else
        echo -e "$yellow""Restoring latest snapshot for [$hpts] from:""$endcolor" "$RESTIC_REPO"
      fi
      case "$flags" in
        -H|--host)
          restic_flag="--host"
          ;;
        -T|--tag)
          restic_flag="--tag"
          ;;
        -p|--path)
          restic_flag="--path"
          ;;
        *)
          echo "Invalid flag [$flags]..."
          echo ""
          restorer-help
          exit
          ;;
      esac
      restic restore latest --target "$restic_restore" "$restic_flag" "$hpts" --verify
      time-end
      ;;
    -s|--snapshot)
      if [[ ! "$hpts" ]] ; then
        echo "No [snapshot ID] indicated."
        echo ""
        restorer-help
        exit
      fi
      time-start
      if [[ "$DESTINATION" ]] ; then
        echo -e "$yellow""Restoring snapshot ID [$hpts] from:""$endcolor" "$DESTINATION..."
      else
        echo -e "$yellow""Restoring snapshot ID [$hpts] from:""$endcolor" "$RESTIC_REPO"
      fi
      restic restore "$hpts" --target "$restic_restore" --verify
      time-end
      ;;
    *)
      echo "Invalid flag [$flags]..."
      echo ""
      restorer-help
      exit
      ;;
  esac
}

function snaps {
  case "$flags" in
    -h|--help)
      snaps-help
