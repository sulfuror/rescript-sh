}

function edit_config_files {
  echo "======================"
  echo "     Config Files     "
  echo "======================"
  echo " [1] Back to Main Menu"
  echo " [2] Exit             "
  echo "----------------------"
  ls $HOME/.rescript/config | grep -e '.conf' | sed -e 's/\.conf$//'
  echo "======================"
  read -p "Write the name of the repo file to open or one of the options above: " conf
  if [[ "$conf" == "1" || "$conf" == "Back" || "$conf" == "back" ]] ; then
    clear
    config_menu
  elif [[ "$conf" == "2" || "$conf" == "Exit" || "$conf" == "exit" ]] ; then
    echo "Exiting..."
    exit
  elif [[ -e $HOME/.rescript/config/$conf.conf ]] ; then
    "$EDITOR" $HOME/.rescript/config/$conf.conf 2> /dev/null
    clear
    edit_config_files
  else
    clear
    echo "There is no repo called ["$conf"]; try again with the correct name."
    edit_config_files
  fi
}  

function new_config_file {
  new_repo="$HOME/.rescript/config/.new"
  touch "$new_repo"
  trap 'rm -rf "$new_repo"' INT QUIT TERM EXIT
  {
  echo "# =============================================================================== #"
  echo "#                   R E S C R I P T    C O N F I G U R A T I O N                  #"
  echo "# =============================================================================== #"
  echo "# You need to set your restic password (password for the repository), the"
  echo "# directory for your repository, the backup directory (by default the backup"
  echo "# directory is your Home directory), the destination name of your backup"
  echo "# (local, S3, B2, Wasabi, remote host, etc.), your tag (empty by default if used)"
  echo "# and your "keep" and "excludes" policies."
  echo "# ------------------------------------------------------------------------------- #"
  echo "#                              R E P O    I N F O                                 #"
  echo "# ------------------------------------------------------------------------------- #"
  echo "# You MUST set these values. "KEEP" values CANNOT be left blank; if you are not"
  echo "# going to use "KEEP" policies the value must be set to "0"."
  echo 'RESTIC_PASSWORD=""'
  echo 'RESTIC_REPO=""'
  echo 'BACKUP_DIR="$HOME"'
  echo 'KEEP_LAST="0"'
  echo 'KEEP_HOURLY="8"'
  echo 'KEEP_DAILY="7"'
  echo 'KEEP_WEEKLY="4"'
  echo 'KEEP_MONTHLY="12"'
  echo 'KEEP_YEARLY="10"'
  echo ""
  echo "# B2 Credentials (leave blank if not used)"
  echo 'B2_ID=""'
  echo 'B2_KEY=""'
  echo ""
  echo "# AWS Credentials (leave blank if not used)"
  echo 'AWS_ID=""'
  echo 'AWS_KEY=""'
  echo ""
  echo "# Optional values; The "DESTINATION" value is just use in this script to display"
  echo "# in the output the name of your destination (e.g.: Google Drive, Amazon, B2, Wasabi,"
  echo "# etc.). The "TAG" value will tag your snapshots with any name/tag you want."
  echo "# The "CLEAN" value determine when it will execute the forget, prune and check"
  echo "# commands; this value must be set in days and by default the number 7 means"
  echo "# it will do these tasks every seven (7) days. These values CAN be left blank"
  echo "# if you are not planning on use them."
  echo 'CLEAN="7"'
  echo 'TAG=""'
  echo 'DESTINATION=""'
  echo ""
  echo "# The variable "LOGGING" is "yes" by default. If you don't want logs to be saved"
  echo "# at .rescript/logs directory just change the "yes" to "no". This will only save"
  echo "# a log when the script is run; options and commands do not save logs."
  echo 'LOGGING="yes"'
  } > "$new_repo"
  chmod 700 "$new_repo"
  read -p "Write the name for your new repository (case sensitive): " repo_name
  if [[ $repo_name ]] ; then
    mv "$new_repo" $HOME/.rescript/config/$repo_name.conf
    touch $HOME/.rescript/config/$repo_name-exclusions
    touch $HOME/.rescript/config/$repo_name-datefile
    date -R > $HOME/.rescript/config/$repo_name-datefile
    {
     echo "# These are the default rescript exclusions:"
     echo "$HOME/.cache/*"
     echo "$HOME/.local/share/Trash/*"
     echo "$HOME/.rescript/lock/*"
     echo "$HOME/.Trash"
     echo "$HOME/.Private"
     echo "$HOME/.ecryptfs"
     echo ""
     echo "# Write your custom exclusions below:"
    } > $HOME/.rescript/config/$repo_name-exclusions
    date -R > $HOME/.rescript/config/$repo_name-datefile
    echo "["$repo_name"] config file have been created. If this is a new repository,"
    echo "you must run [rescript "$repo_name" init] to initialize your new repository"
    echo "before executing any other command. You also need to edit your new config"
    echo "file to proceed."
    read -p "Would you like to open ["$repo_name"] config file now? y/n " answer
    if [[ "$answer" == "y" || "$answer" == "yes" || "$answer" == "Yes" || "$answer" == "YES" || "$answer" == "Y" ]] ; then
      "$EDITOR" $HOME/.rescript/config/$repo_name.conf 2> /dev/null
      clear
      config_menu
    elif [[ "$answer" == "n" || "$answer" == "no" || "$answer" == "No" || "$answer" == "NO" || "$answer" == "N" ]] ; then
      echo "Remember to configure your repo file before continuing!"
      exit
    else
      clear
      echo "Invalid action..."
      config_menu
    fi
  else
    rm -rf "$new_repo"
    echo "Exiting..."
    exit
  fi
}

function delete_config_file {
  echo "======================"
  echo "     Config Files     "
  echo "======================"
  echo " [1] Back to Main Menu"
  echo " [2] Exit             "
  echo "----------------------"
  ls $HOME/.rescript/config | grep -e '.conf' | sed -e 's/\.conf$//'
  echo "======================"
  read -p "Type the name of the repo file you wish to delete: " del
  if [[ "$del" == "1" || "$del" == "Back" ||"$del" == "back" ]] ; then
    clear
    config_menu
  elif [[ "$del" == "2" || "$del" == "Exit" ||"$del" == "exit" ]] ; then
    echo "Exiting..."
    exit
  elif [[ "$HOME/.rescript/config/$del.conf" ]] ; then
    read -p "Are you sure you want to delete ["$del"]? y/n: " ans
    if [[ "$ans" == "y" || "$ans" == "yes" || "$ans" == "Yes" || "$ans" == "YES" || "$ans" == "Y" ]] ; then
      rm -rf $HOME/.rescript/config/$del.conf
      rm -rf $HOME/.rescript/config/$del-exclusions
      rm -rf $HOME/.rescript/config/$del-datefile
      clear
      echo "[$del] repository configuration have been removed."
      delete_config_file
    elif [[ "$ans" == "n" || "$ans" == "no" || "$ans" == "No" || "$ans" == "NO" || "$ans" == "N" ]] ; then
      clear
      delete_config_file
    elif [[ "$ans" == "exit" || "$ans" == "Exit" ]] ; then
      echo "Exiting..."
      exit
    else
      echo "No action indicated; exiting..."
      exit
    fi
  else
    clear
    echo "No action indicated..."
    exit
  fi
}

