        previous_snapshot=$(restic snapshots --compact --host "$HOST" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOST" | tail -3 | head -1 | awk '{print $1}')
