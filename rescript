function print_progress {
  local label="$1"
  local percent="$2"
  local length=20
  local fill=$(( (percent * length) / 100 ))
  local empty=$(( length - fill ))
  
  printf "%-30s: [" "$label"
  
  if [[ $fill -gt 0 ]]; then
    printf "%${fill}s" "" | tr ' ' '#'
  fi
  if [[ $empty -gt 0 ]]; then
    printf "%${empty}s" "" | tr ' ' '-'
  fi
  
  printf "](%s%%)\r" "$percent"
}
