    echo "======================"
    read -p "Type the name of the exclusion file you want to build or one of the options above [ 1 - 2 ]: " excl_file
    if [[ "$excl_file" == "1" || "$excl_file" == "Back" || "$excl_file" == "back" ]] ; then
      clear
