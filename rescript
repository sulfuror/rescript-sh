function time-start {
  if [[ ! "$cmd" ]] ; then
    title="S T A R T I N G    B A C K U P"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
    echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""System:""$endcolor" "$(opsys)"
    if [[ "$HOST" ]] ; then
      echo -e "$yellow""Hostname:""$endcolor" "$HOST"
    else
      echo -e "$yellow""Hostname:""$endcolor" "$(hostname)"
    fi
    if [[ "$DESTINATION" ]] ; then
      echo -e "$yellow""Backup Destination:""$endcolor" "$DESTINATION"
    else
      echo -e "$yellow""Backup Destination:""$endcolor" "$RESTIC_REPO"
    fi
    printf "%$((80/1))s\n" "" | tr ' ' -
  fi
  if [[ "$cmd" ]] ; then 
    case "$cmd" in
      backup|checkout|cleanup|restorer)
        if [[ "$cmd" = "backup" ]] ; then
          title="S T A R T I N G    B A C K U P"
        elif [[ "$cmd" = "checkout" ]] ; then
          title="S T A R T I N G    C H E C K O U T"
        elif [[ "$cmd" = "cleanup" ]] ; then
          title="S T A R T I N G    C L E A N U P"
        elif [[ "$cmd" = "restorer" ]] ; then
          title="S T A R T I N G    R E S T O R E R"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' =
        printf "%$(((80 + ${#title}) / 2))s\n" "$title"
        printf "%$((80/1))s\n" "" | tr ' ' =
        echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""System:""$endcolor" "$(opsys)"
        if [[ "$HOST" ]] ; then
          echo -e "$yellow""Hostname:""$endcolor" "$HOST"
        else
          echo -e "$yellow""Hostname:""$endcolor" "$(hostname)"
        fi
        if [[ "$DESTINATION" ]] ; then
          echo -e "$yellow""Backup Destination:""$endcolor" "$DESTINATION"
        else
          echo -e "$yellow""Backup Destination:""$endcolor" "$RESTIC_REPO"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' -
        ;;
      *)
        echo -e "$yellow""Starting [$cmd] for [$repo]...""$endcolor"
        echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        printf "%$((80/1))s\n" "" | tr ' ' -
        ;;
    esac
  fi
}

function time-end {
  if [[ ! "$cmd" ]] ; then
    title="B A C K U P    E N D E D"
    printf "%$((80/1))s\n" "" | tr ' ' -
    echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""Duration:""$endcolor" "$(duration)"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
  fi
  if [[ "$cmd" ]] ; then
    case "$cmd" in
      backup|checkout|cleanup|restorer)
        if [[ "$cmd" = "backup" ]] ; then
          title="B A C K U P    E N D E D"
        elif [[ "$cmd" = "checkout" ]] ; then
          title="C H E C K O U T    E N D E D"
        elif [[ "$cmd" = "cleanup" ]] ; then
          title="C L E A N U P    E N D E D"
        elif [[ "$cmd" = "restorer" ]] ; then
          title="R E S T O R E R    E N D E D"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""Duration:""$endcolor" "$(duration)"
        printf "%$((80/1))s\n" "" | tr ' ' =
        printf "%$(((80 + ${#title}) / 2))s\n" "$title"
        printf "%$((80/1))s\n" "" | tr ' ' =
        ;;
      *)
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""Duration:""$endcolor" "$(duration)"
        ;;
    esac
  fi
}

function unlocker {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        unlocker-help
        exit
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        unlocker-help
        exit
        ;;
    esac
  fi
  if [[ ! -e "$lock" ]]; then
    echo "No locks found..."
  else
    rm -rf "$lock"
    echo "Script unlocked..."
  fi
}

