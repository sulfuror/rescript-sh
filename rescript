      echo "Exiting..."
      exit
    elif [[ -e "$HOME/.rescript/config/$excl_file-exclusions" ]] ; then 
      echo "This action will override your existing [$excl_file] exclusion file."
      read -p "Are you sure you want to proceed? y/n: " ans_excl
      if [[ "$ans_excl" == "yes" || "$ans_excl" == "y" || "$ans_excl" == "Yes" || "$ans_excl" == "Y" || "$ans_excl" == "YES" ]] ; then
        if [[ -e "$HOME/.rescript/config/$excl_file-exclusions" ]] ; then
	  {
	  echo "# These are the default rescript exclusions for your system:"
	  echo "/home/*"
	  echo "/proc/*"
	  echo "/sys/*"
	  echo "/dev/*"
	  echo "/run/*"
	  echo "/mnt/*"
	  echo "/media/*"
	  echo "/etc/mtab"
	  echo "/var/cache/apt/archives/*.deb"
	  echo "lost+found/*"
	  echo "/tmp/*"
	  echo "/var/tmp/*"
	  echo "/var/backups/*"
	  echo ""
	  echo "# Write your custom exclusions below:"
	  } > "$HOME/.rescript/config/$excl_file-exclusions"
	  clear
	  echo "Done building exclusion list for ["$excl_file"]."
	  build_exclusions
        else
	  clear
	  echo "There is no exclusion file called ["$excl_file"]; try again with the correct name."
	  build_exclusions
        fi
      elif [[ "$ans_excl" == "no" || "$ans_excl" == "n" || "$ans_excl" == "No" || "$ans_excl" == "N" || "$ans_excl" == "NO" ]] ; then
        clear
        echo "No changes made."
        build_exclusions
      fi
    else
      clear
      echo "There is no exclusion file called [$excl_file]."
      build_exclusions
    fi
  elif [[ "$excl_bld" == "3" || "$excl_bld" == "Back" ||"$excl_bld" == "back" ]] ; then
    clear
    exclusion_menu
  elif [[ "$excl_bld" == "4" || "$excl_bld" == "Exit" ||"$excl_bld" == "exit" ]] ; then
    echo "Exiting..."
    exit
  else
    clear
    echo "No valid action indicated..."
    build_exclusions
  fi
}

