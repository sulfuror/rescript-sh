      fi
    else
      if ls "$logs_dir/$logfile" 1> /dev/null 2>&1 ; then
        rm -rfv "${logs_dir:?}/$logfile"
        echo "[$logfile] removed."
        exit 0
      else
        echo "There are is log file called [$logfile]."
        exit 1
      fi
    fi
  else
    echo "Something is not right."
    exit 1
  fi
