#!/usr/bin/env bash
# ============================================================== #
version="3.8"
usage="
Author		: Sulfuror, Copyright (c) 2018 <sulfuror@gmail.com>
URL		: https://gitlab.com/sulfuror/rescript.sh
License		: BSD 2-clause 'Simplified' License
Version		: $version
Description	: rescript is a bash script created to manage
		  backups made with restic program.

'restic is a backup program which allows saving multiple revisions 
of files and directories in an encrypted repository 
stored on different backends.'

For more information about restic visit https://restic.net

This script will run backup, snapshots, forget, prune, check and
stats commands automatically by just indicating the name given
to your repository. e.g.:

  rescript [repo_name]

All restic commands are available within this script except for
[backup], which exists but it will use your configuration
file to perform a backup.

Usage:
  rescript [config_command]
OR
  rescript [repo_name] [rescript_command]
OR
  rescript [repo_name] [restic_command]
  
Rescript configuration commands:
  config		Rescript configuration; set your default
  			text editor, open, delete or modify your
  			configuration and exclusion files. This command
  			does not need a [repo_name].
  editor		Change the default rescript text editor used
  			to open your configuration and exclusions files.
  			This command does not need a [repo_name].
  help			Display rescript help and usage. This command
  			does not need a [repo_name].
  install		Install rescript (this just move the script
  			to your .local/bin directory for convenience.
  			This command does not need a [repo_name].
  update		Update is used to update the script itself
  			when a new version is available.
  
Rescript commands:
  backup		Take a snapshot using the values set in
  			your configuration file.
  checkout		This command will execute check using
  			[--read-data-subset] and selecting a random
  			number between 1-10 out of 10 groups.
  cleanup		Forget and prune according to the policies
  			in your configuration file.
  logs			This command needs a flag to view, list
			or delete your log files.
  mounter		Mount a restic repo.
  restorer		Restore a restic snapshot.	
  unlocker		Remove lock created by rescript.
  version		Display rescript version. This command does
  			not need a [repo_name].

Rescript glogal flags:
  -h, --help		This flag is available for all rescript commands
  			and it can be used to display the usage for every
  			single rescript command.
  -l, --log		This flag is available for all rescript and restic
  			commands. This will create a log file
  			with the command output. You can combine this
  			flag with [--time].
  -t, --time		This flag is available ONLY for restic commands.
			This flag will display an output with the date,
			time and duration of the command. You can
			combine this flag with [--log].

These global flags must be used BEFORE the command. To see usage and
flags available for a specific command type:
  rescript help [command]
"
# ============================================================== #
YELLOW="\033[33m"
ENDCOLOR="\033[0m"
SECONDS=0
EXCLUDES="$HOME/.rescript/config/$1-exclusions"
LOCK="$HOME/.rescript/lock/$1.lock"
RMOUNT="$HOME/"$1"-repo-$(date +%s)"
REPO="$1"

# Create a rescript directories if they are not present
if [[ ! -d "$HOME/.rescript" ]]; then
  mkdir -p "$HOME/.rescript"
fi
if [[ ! -d "$HOME/.rescript/config" ]]; then
  mkdir -p "$HOME/.rescript/config"
fi
if [[ ! -d "$HOME/.rescript/lock" ]]; then
  mkdir -p "$HOME/.rescript/lock"
fi
if [[ ! -d "$HOME/.rescript/logs" ]]; then
  mkdir -p "$HOME/.rescript/logs"
fi
# Create "editor" file if not present
if [[ ! -f "$HOME/.rescript/config/.editor" ]] ; then
  touch $HOME/.rescript/config/.editor
fi
EDITOR="$(cat $HOME/.rescript/config/.editor)"
# Set PATH so it includes user's private bin if it exists (cron jobs may require this)
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

function opsys {
  OS_NAME="$(uname -s)"
  if [[ "$OS_NAME" == "Linux" || "$OS_NAME" == "Linux" ]] ; then
    echo -e "$(lsb_release -ds)"
  elif [[ "$OS_NAME" == "FreeBSD"* ]] ; then
    echo -e "$(uname -rs)"
  elif [[ "$OS_NAME" == "Darwin"* ]] ; then
    OS="$(sw_vers -productName)"
    OS_VERS="$(sw_vers -productVersion)"
    echo -e "$OS $OS_VERS"
  fi
}

function duration {
  D="$((SECONDS/60/60/24))"
  H="$((SECONDS/60/60%24))"
  M="$((SECONDS/60%60))"
  S="$((SECONDS%60))"
  if [[ "$D" == "1" ]] ; then
    DAYS="day"
  else
    DAYS="days"
  fi
  if [[ "$H" == "1" ]] ; then
    HRS="hour"
  else
    HRS="hours"
  fi
  if [[ "$M" == "1" ]] ; then
    MIN="minute"
  else
    MIN="minutes"
  fi
  if [[ "$S" == "1" ]] ; then
    SEC="second"
  else
    SEC="seconds"
  fi
  if [[ "$D" -gt "0" ]] ; then
    echo "$D $DAYS $H $HRS $M $MIN and $S $SEC"
  elif [[ "$H" -gt "0" ]] ; then
    echo "$H $HRS $M $MIN and $S $SEC"
  elif [[ "$M" -gt "0" ]] ; then
    echo "$M $MIN and $S $SEC"
  else
    echo "$S $SEC"
  fi
}
