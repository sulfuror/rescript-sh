function archive {
  if [[ ! $(which rsync) ]] ; then
    echo "***$(basename "$0") warning***"
    echo "[rsync] not found..."
    echo ""
    echo "[$cmd] works with [rsync] to merge data into one directory."
    echo "Please, install [rsync] to proceed."
    exit
  fi
  if [[ "$cmd" != "archive" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ ! -z "$host_flag" ]] ; then
    host_archive="$host_flag"
    if [[ ! "$(restic snapshots --compact --host "$host_flag" | tail -1 | awk '{print $1}')" ]] ; then
      echo "There is no host named [$host_flag] in your repository."
      exit
    fi
  elif [[ ! -z "$HOST" ]] ; then
    host_archive="$HOST"
  else
    host_archive="$(hostname)"
  fi
  if [[ "$cmd" = "archive" ]] ; then
    logger
    time_start
  fi
  debug_start
  echo "Starting archive..."
  check_snapshots=$( restic snapshots --compact --host "$host_archive")
  check_archives=$(restic snapshots --compact --host "$host_archive" --tag "archive" --path "/tmp/archive")
  if [[ "$(echo "$check_snapshots" | tail -1 | awk '{print $1}')" -lt "2" ]] ; then
    echo "There is only $(echo "$check_snapshots" | tail -1 | awk '{print $1}') snapshot available."
    echo "Listing snapshots..."
    echo "$check_snapshots"
    debug_stop
    if [[ "$info_flag" = "true" && "$cmd" = "archive" ]] ; then
      statinfo
    fi
    if [[ "$cmd" = "archive" ]] ; then
      time_end
    fi
  fi
  if [[ "$(echo "$check_snapshots" | tail -1 | awk '{print $1}')" = "2" && "$(echo "$check_archives" | tail -1 | awk '{print $1}')" -gt "0" ]] ; then
    echo "There are no files to archive..."
    debug_stop
    if [[ "$info_flag" = "true" && "$cmd" = "archive" ]] ; then
      statinfo
    fi
    if [[ "$cmd" = "archive" ]] ; then
      time_end
    fi
  fi
  echo -ne 'Checking for files to archive: [########                ](33%)\r'
  prevsnap=$(echo "$check_snapshots" | tail -4 | head -1 | awk '{print $1}')
  echo -ne 'Checking for files to archive: [################        ](66%)\r'
  latesnap=$(echo "$check_snapshots" | tail -3 | head -1 | awk '{print $1}')
  case "$(uname -s)" in
    Darwin)
      rescript_archive="$tmp_dir/$(gtr -dc '0-9A-Z' < /dev/urandom | head -c 40)"
      ;;
    *)
      rescript_archive="$tmp_dir/$(tr -dc '0-9A-Z' < /dev/urandom | head -c 40)"
      ;;
  esac
  archiver="$tmp_dir/archive"
  archiver_latest="$tmp_dir/archive_latest"
  archiver_old="$tmp_dir/archive_old"
  restic diff "$prevsnap" "$latesnap" | grep -e '-    /' | sed -e 's/^-    //g' > "$rescript_archive"
  echo -ne 'Checking for files to archive : [########################](100%)\r'
  echo -ne '\n'
  wait
  if [[ ! -s "$rescript_archive" ]] ; then
    rm -rf "$rescript_archive" >> /dev/null 2>&1
    echo "There are no files to archive..."
    debug_stop
    if [[ "$info_flag" = "true" && "$cmd" = "archive" ]] ; then
      statinfo
    fi
    if [[ "$cmd" = "archive" ]] ; then
      time_end
    fi
  else
    if [[ "$(grep -c "/" "$rescript_archive")" = "1" ]] ; then
      echo "There is $(grep -c "/" "$rescript_archive") file deleted from the latest snapshot:"
    else
      echo "There are $(grep -c "/" "$rescript_archive") files deleted from the latest snapshot:"
    fi
    cat -n "$rescript_archive"
    echo -ne 'Restoring deleted files       : [#####                   ](20%)\r'
    eval filter="( $(sed 's/ \+/\\ /g' < "$rescript_archive" | sed 's/^/--include="/' | sed 's/$/"/') )"
    wait
    restic restore "${filter[@]}" --verify "$prevsnap" -t "$archiver_latest" >> /dev/null 2>&1 &
    latest_cmd=$prev_cmd cmd_error="$?"
      if [[ "$cmd_error" -gt "0" ]] ; then
        { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
        latest_error
      fi
    wait
    echo -ne 'Restoring deleted files       : [##########              ](40%)\r'
    if [[ "$(echo "$check_archives" | tail -1 | awk '{print $1}')" -gt "0" ]] ; then
      restic restore --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" --verify latest -t "$archiver_old" >> /dev/null 2>&1
      latest_cmd=$prev_cmd cmd_error="$?"
      if [[ "$cmd_error" -gt "0" ]] ; then
        { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
        latest_error
      fi
    fi
    wait
    echo -ne 'Restoring deleted files       : [###############         ](60%)\r'
    restic forget --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" --keep-last="1" >> /dev/null 2>&1
    latest_cmd=$prev_cmd cmd_error="$?"
    if [[ "$cmd_error" -gt "0" ]] ; then
      { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
      latest_error
    fi
    wait
    echo -ne 'Restoring deleted files       : [####################    ](80%)\r'
    restic forget --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" latest >> /dev/null 2>&1
    latest_cmd=$prev_cmd cmd_error="$?"
    if [[ "$cmd_error" -gt "0" ]] ; then
      { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
      latest_error
    fi
    wait
    echo -ne 'Restoring deleted files       : [########################](100%)\r'
    echo -ne '\n'
    if [[ -d "$archiver_old" ]] ; then
      echo -ne 'Merging data                  : [########                ](33%)\r'
      rsync -a $archiver_old/tmp/archive/* $archiver >> /dev/null 2>&1
      latest_cmd=$prev_cmd cmd_error="$?"
      if [[ "$cmd_error" -gt "0" ]] ; then
        { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
        latest_error
      fi
      wait
      echo -ne 'Merging data                  : [################        ](66%)\r'
      rsync -a $archiver_latest/* $archiver >> /dev/null 2>&1
      latest_cmd=$prev_cmd cmd_error="$?"
      if [[ "$cmd_error" -gt "0" ]] ; then
        { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
        latest_error
      fi
      wait
      echo -ne 'Merging data                  : [########################](100%)\r'
      echo -ne '\n'
    else
      echo -ne 'Merging data                  : [############            ](50%)\r'
      rsync -a $archiver_latest/* $archiver >> /dev/null 2>&1
      latest_cmd=$prev_cmd cmd_error="$?"
      if [[ "$cmd_error" -gt "0" ]] ; then
        { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
        latest_error
      fi
      wait
      echo -ne 'Merging data                  : [########################](100%)\r'
      echo -ne '\n'
    fi
    echo -ne 'Archiving deleted files       : [############            ](50%)\r'
    restic backup --time "2015-$(date +%m-%d) $(date +%H:%M:%S)" --tag archive --host "$host_archive" "$archiver" >> /dev/null 2>&1
    latest_cmd=$prev_cmd cmd_error="$?"
    if [[ "$cmd_error" -gt "0" ]] ; then
      { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
      latest_error
    fi
    wait
    echo -ne 'Archiving deleted files       : [########################](100%)\r'
    echo -ne '\nArchive Completed!\n'
    debug_stop
    { rm -rf "$rescript_archive" ; rm -rf "$archiver" ; rm -rf "$archiver_latest" ; rm -rf "$archiver_old" ; }
    if [[ "$info_flag" = "true" && "$cmd" = "archive" ]] ; then
      statinfo
    fi
    if [[ "$cmd" = "archive" ]] ; then
      time_end
    fi
  fi
}

function automatic {
  rescript_lock
  case "$LOGGING" in
    y|yes)
      log_flag="true"
      logger
      ;;
  esac
  time_start
  # Backup
  case "$SKIP_OFFICE" in
    y|yes)
      echo -e "$yellow""[Taking a Snapshot...]""$endcolor" ; skip_flag="true" ; backup ;;
    *)
      echo -e "$yellow""[Taking a Snapshot...]""$endcolor" ; backup ;;
  esac
  exclusions=$(grep -E -v -n -c '(^#|^\s*$|^\s*\t*#)' "$excludes")
  if [[ "$exclusions" -gt "0" ]] ; then
    echo -e "$yellow""There are $exclusions exclusion rules...""$endcolor"
  fi
  printf "%$((80/1))s\n" "" | tr ' ' -
  # Snapshot List
  echo -e "$yellow""[Snapshots List...]""$endcolor"
  snaps
  printf "%$((80/1))s\n" "" | tr ' ' -
  latest_cmd=$prev_cmd cmd_error="$?"
  latest_error
  case "$ARCHIVE" in
    y|yes) echo -e "$yellow""[Starting archive...]""$endcolor" ; archive ; printf "%$((80/1))s\n" "" | tr ' ' - ;;
  esac
  # Check and Clean Repo Based on User's Policy
  if [[ -f "$config_dir/$repo-datefile" || "$CLEAN" -gt "0" ]]; then
    if [[ ! -f "$config_dir/$repo-datefile" ]] ; then
      touch "$config_dir/$repo-datefile"
    fi
    now_next
    if [[ "$now" -lt "$next" ]] ; then
      cleanup-next
    else 
      if [[ ! -z "${policies[*]}" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        cleanup
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
        latest_cmd=$prev_cmd cmd_error="$?"
        latest_error
        printf "%$((80/1))s\n" "" | tr ' ' -
        if [[ "$CLEAN" -gt "0" ]] ; then
          if [[ "$CLEAN" = "1" ]] ; then
            d="day"
          else
            d="days"
          fi
          echo -e "$yellow""[Done Cleaning; Next Cleanup and Check Will Be Done in $CLEAN $d...]""$endcolor"
          case "$(uname -s)" in
            Linux|GNU)
              date -d now+"$CLEAN"days > "$config_dir/$repo-datefile"
              ;;
            *)
              gdate -d now+"$CLEAN"days > "$config_dir/$repo-datefile"
              ;;
          esac
        fi
      fi
    fi
  else 
      if [[ ! -z "${policies[*]}" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        cleanup
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
        latest_cmd=$prev_cmd cmd_error="$?"
        latest_error
      fi
  fi
  # Stats
  statinfo
  # Time and Runtime
  time_end
  if [[ "$CLEAN" -gt "0" && -z "${policies[*]}" ]] ; then
    if [[ "$CLEAN" = "1" ]] ; then
      d="day"
    else
      d="days"
    fi
    echo "[rescript] noted that your CLEAN variable is $CLEAN, so [rescript] assumes that"
    echo "you want to perform a 'cleanup' (forget, prune and check) every $CLEAN $d but"
    echo "it can't execute it if you have not set the KEEP variables; please set your"
    echo "desired KEEP values in order to perform the 'cleanup' every $CLEAN $d. If you"
    echo "don't want [rescript] to 'cleanup' your repo automatically every $CLEAN $d,"
    echo "just leave the CLEAN variable blank in your cofiguration file and this"
    echo "message will not appear again."
    echo ""
    echo "For more info about this subject:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function backup {
  if [[ "$cmd" != "backup" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$cmd" = "backup" ]] ; then
    logger
    time_start
  fi
  if [[ "$skip_flag" = "true" ]] ; then
    debug_start
    restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host --exclude-file=<(find $BACKUP_DIR -iname ".~lock.*" 2> /dev/null | sed -e 's/.~lock.//g' | sed -e 's/#//g') --exclude=".~lock.*" ${rest[@]} $BACKUP_DIR
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
  else
    debug_start
    restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host ${rest[@]} $BACKUP_DIR
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
  fi
  if [[ "$archive_flag" = "true" ]] ; then
    archive
  fi
  if [[ "$cleanup_flag" = "true" ]] ; then
    echo "Starting [cleanup]..."
    cleanup
  fi
  if [[ "$info_flag" = "true" && "$cmd" = "backup" ]] ; then
    statinfo
  fi
  if [[ "$cmd" = "backup" ]] ; then
    time_end
  fi
}


function statinfo {
  if [[ "$cmd" != "info" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$cmd" = "info" ]] ; then
    logger
    time_start
  fi
  if [[ "$cmd" != "info" ]] ; then
    printf "%$((80/1))s\n" "" | tr ' ' -
  fi
  if [[ ! -z "$HOST" ]] ; then
    stat_host="$HOST"
  else
    stat_host="$(hostname)"
  fi
  debug_start
  echo -ne 'Processing stats              : [#####                   ](20%)\r'
  latest_host_stat="$(restic stats --host "$stat_host" latest | grep 'Total Size' | sed 's/Total Size: //g')"
  latest_cmd=$prev_cmd cmd_error="$?"
  latest_error
  echo -ne 'Processing stats              : [#########               ](40%)\r'
  host_stat="$(restic stats --mode raw-data --host "$stat_host" latest | grep 'Total Size' | sed 's/Total Size: //g')"
  latest_cmd=$prev_cmd cmd_error="$?"
  latest_error
  echo -ne 'Processing stats              : [###############         ](60%)\r'
  stat_restore_size="$(restic stats | grep 'Total Size' | sed 's/Total Size: //g')"
  latest_cmd=$prev_cmd cmd_error="$?"
  latest_error
  echo -ne 'Processing stats              : [#####################   ](80%)\r'
  stat_raw_data="$(restic stats --mode raw-data | grep 'Total Size' | sed 's/Total Size: //g')"
  latest_cmd=$prev_cmd cmd_error="$?"
  latest_error
  debug_stop
  echo -ne 'Processing stats              : [########################](100%)\r'
  printf "%-25s %25s %25s\n" "Summarized Info" "Restore Size" "Deduplicated Size"
  printf "%$((80/1))s\n" "" | tr ' ' -
  printf "%-25s %25s %25s\n" "Latest Snapshot" "$latest_host_stat" "$host_stat"
  printf "%-25s %25s %25s\n" "All Snapshots" "$stat_restore_size" "$stat_raw_data"
  if [[ "$cmd" = "info" ]] ; then
    time_end
  fi
}

function changes {
  if [[ "$cmd" != "changes" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$cmd" = "changes" ]] ; then
    logger
    time_start
  fi
  if [[ ! -z "$path_flag" ]] ; then
    path="--path $path_flag"
  fi
  if [[ ! -z "$tag_flag" ]] ; then
    tag="--tag $tag_flag"
  fi
  if [[ ! -z "$host_flag" ]] ; then
    host="--host $host_flag"
  elif [[ ! -z "$HOST" ]] ; then
    host="--host $HOST"
  else
    host="--host $(hostname)"
  fi
  options=(
    $path
    $tag
    $host
  )
  if [[ "$metadata_flag" = "true" ]] ; then
    add_meta="--metadata"
  fi
  echo -ne 'Retrieving snapshots          : [############            ](50%)\r'
  debug_start
  snapshots=$(restic snapshots --compact ${options[@]})
  latest_cmd=$prev_cmd cmd_error="$?"
  debug_stop
  latest_error
  previous_snapshot=$(echo "$snapshots" | tail -4 | head -1 | awk '{print $1}')
  latest_snapshot=$(echo "$snapshots" | tail -3 | head -1 | awk '{print $1}')
  echo -ne 'Retrieving snapshots          : [########################](100%)\r'
  echo -ne '\n'
  if [[ -z "$previous_snapshot" || -z "$latest_snapshot" ]] ; then
    echo "It seems the repository does not have snapshots to compare with; if any option was indicated, please check if the hostname, tagname or path were misspelled."
    time_end
    exit 1
  fi
  debug_start
  restic diff "$previous_snapshot" "$latest_snapshot" $add_meta
  latest_cmd=$prev_cmd cmd_error="$?"
  debug_stop
  latest_error
  time_end
}

function cleanup {
  if [[ "$cmd" != "cleanup" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$cmd" = "cleanup" ]] ; then
    logger
    time_start
  fi
  if [[ "$cmd" = "cleanup" && "$archive_flag" = "true" ]] ; then
    archive
  fi
  if [[ ! -z "${policies[*]}" ]] ; then
    debug_start
    restic forget "${policies[@]}" ${rest[@]}
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
    debug_start
    restic prune --cleanup-cache
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
    if [[ -f "$config_dir/$repo-datefile" || "$CLEAN" -gt "0" ]] ; then
      if [[ "$cmd" = "cleanup" ]] ; then
        cleanup-next
      fi
    fi
  else
    echo -e "$yellow""You have not indicated any policy value...""$endcolor"
    echo "If you want to use [cleanup] option you need to set the [KEEP] variables."
    echo "For more information about the Usage check out the following link:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
  if [[ "$info_flag" = "true"  && "$cmd" = "cleanup" ]] ; then
    statinfo
  fi
  if [[ "$cmd" = "cleanup" ]] ; then
    time_end
  fi
}

function cleanup-next {
  if [[ ! -f "$config_dir/$repo-datefile" ]] ; then
    touch "$config_dir/$repo-datefile"
  fi
  now_next
  result=$((next-now))
  days=$((result / 86400))
  hours=$(((result / 3600) % 24))
  minutes=$(((result / 60) % 60))
  if [[ "$days" = "1" ]] ; then
    d="day"
  else
    d="days"
  fi
  if [[ "$hours" = "1" ]] ; then
    h="hour"
  else
    h="hours"
  fi
  if [[ "$minutes" = "1" ]] ; then
    m="minute"
  else
    m="minutes"
  fi
  if [[ "$days" -gt "0" ]] ; then
    if [[ "$hours" -gt "0" ]] ; then
        if [[ "$minutes" -gt "0" ]] ; then
          echo -e "$yellow""Next cleanup and check in $days $d, $hours $h and $minutes $m...""$endcolor"
        else
          echo -e "$yellow""Next cleanup and check in $days $d and $hours $h...""$endcolor"
        fi
    elif [[ "$minutes" -gt "0" ]] ; then
      echo -e "$yellow""Next cleanup and check in $days $d and $minutes $m...""$endcolor"
    else
      echo -e "$yellow""Next cleanup and check in $days $d...""$endcolor"
    fi
  elif [[ "$hours" -gt "0" ]] ; then
    if [[ "$minutes" -gt "0" ]] ; then
      echo -e "$yellow""Next cleanup and check in $hours $h and $minutes $m...""$endcolor"
    else
      echo -e "$yellow""Next cleanup and check in $hours $h...""$endcolor"
    fi
  elif [[ "$minutes" -gt "0" ]] ; then
    echo -e "$yellow""Next cleanup and check in $minutes $m...""$endcolor"
  else
    echo -e "$yellow""Repo will be cleaned and checked in the next run...""$endcolor"
  fi
}

function debug_start {
  if [[ "$debug_flag" = "true" ]] ; then
    set -xv
  fi
}

function debug_stop {
  if [[ "$debug_flag" = "true" ]] ; then
    set +xv
  fi
}

function env_conf {
  if [[ "$var_flag" ]] ; then
    if [[ ! $(    sed '/^#/ d' < "$config_dir/$repo.conf" | sed '/^\s*$/d' | grep "$var_flag") ]] ; then
      echo "There is no var named [$var_flag]... try using UPPERCASE"
      echo ""
      env-help
      exit 1
    else
      sed '/^#/ d' < "$config_dir/$repo.conf" | sed '/^\s*$/d' | grep "$var_flag"
    fi
  else
    sed '/^#/ d' < "$config_dir/$repo.conf" | sed '/^\s*$/d'
  fi
}

function logs {
  shopt -u nocasematch
  if [[ ! "$flags" ]] ; then
    if ls "$logs_dir/$repo"-* 1> /dev/null 2>&1 ; then
      ls $logs_dir/ | grep -e "$repo"
      echo ""
      echo "Your logs are saved at $logs_dir"
    else
      echo "There are no log files to list for [$repo]."
    fi
  fi
  if [[ "$flags" ]] ; then
    case "$flags" in
      -c|--cat)
        if [[ "$logfile" ]] ; then
          cat "$logs_dir/$logfile"
        else
          echo "No log file indicated..."
          exit 1
        fi
        ;;
      -h|--help)
        logs-help
        exit 0
        ;;
      -r|--remove)
        if [[ "$logfile" ]] ; then
          rm -rf "$logs_dir/$logfile"
          echo "[$logfile] removed."
        elif ls "$logs_dir/$repo"-* 1> /dev/null 2>&1 ; then
          rm -rf "$logs_dir/$repo"-*
          echo "Log files removed for [$repo]."
        else
          echo "There are no log files to remove for [$repo]." 
        fi
        ;;
      *)
        echo "Invalid option [$flags]..."
        echo ""
        logs-help
        exit 1
        ;;
    esac
  fi
}

function logger {
  if [[ "$log_flag" = "true" ]] ; then
    if [[ ! "$cmd" ]] ; then
      log="$logs_dir/$repo-log-$(date +%Y-%m-%d-%H:%M).log"
    else
      log="$logs_dir/$repo-$cmd-log-$(date +%Y-%m-%d-%H:%M).log"
    fi
    exec > >(tee -a "$log") 2>&1
  fi
}

function mounter {
  rescript_lock
  mkdir "$rmount"
  restic mount ${rest[@]} "$rmount"
  rm -rf "$rmount"
}

function non_opt {
  echo ""
  $cmd-help
  exit 1
}

function now_next {
  case "$(uname -s)" in
    Linux|GNU)
      now=$(date +"%s")
      next=$(date -f "$config_dir/$repo-datefile" "+%s")
      ;;
    *)
      now=$(gdate +"%s")
      next=$(gdate -f "$config_dir/$repo-datefile" "+%s")
      ;;
  esac
}

function random-check {
  rescript_lock
  if [[ "$cmd" = "checkout" ]] ; then
    logger
    time_start
  fi
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  debug_start
  restic check --read-data-subset $((RANDOM % 10 + 1))/10
  latest_cmd=$prev_cmd cmd_error="$?"
  debug_stop
  latest_error
  if [[ "$cmd" = "checkout" ]] ; then
    time_end
  fi
}

function rescript_lock {
  if [ -e "$lock" ]; then
    echo "WARNING: [$repo] repo is already running..."
    echo "If you are sure $repo is not running, type"
    echo " "
    echo "  rescript $repo unlocker"
    echo " "
    echo "This will remove the lock for [$repo] repository."
    echo ""
    echo "Lock file info:"
    stat "$lock_dir/$repo.lock"
    exit
  fi
  touch "$lock"
  trap 'rm -rf "$lock"' INT QUIT TERM EXIT
}

function restic_alone {
  rescript_lock
  logger
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  time_start
  debug_start
  restic ${rest[@]}
  latest_cmd=$prev_cmd cmd_error="$?"
  debug_stop
  rest_cmd=$(echo "${rest[@]}" | awk '{print $1}')
  latest_error
  time_end
}

function restorer {
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$host_flag" ]] ; then
    restore_dir="$HOME/restore-latest-host-"$host_flag"_$(date +%s)"
    restore_opts="--host $host_flag"
  elif [[ "$path_flag" ]] ; then
    restore_dir="$HOME/restore-latest-by-path_$(date +%s)"
    restore_opts="--path $path_flag"
  elif [[ "$tag_flag" ]] ; then
    restore_dir="$HOME/restore-latest-tag-"$tag_flag"_$(date +%s)"
    restore_opts="--tag $tag_flag"
  else
    restore_dir="$HOME/restore-ID-"$snap_flag"_$(date +%s)"
    snap_id="$snap_flag"
  fi
  if [[ "$cmd" = "restorer" ]] ; then
    logger
    time_start
  fi
  if [[ "$DESTINATION" ]] ; then
    echo -e "$yellow""Restoring from:""$endcolor" "$DESTINATION..."
  else
    echo -e "$yellow""Restoring from:""$endcolor" "$RESTIC_REPO"
  fi
  if [[ "$snap_id" ]] ; then
    debug_start
    restic restore $snap_id --target $restore_dir --verify
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
  else
    debug_start
    restic restore latest --target $restore_dir $restore_opts --verify
    latest_cmd=$prev_cmd cmd_error="$?"
    debug_stop
    latest_error
  fi
  report_errors
  if [[ "$cmd" = "restorer" ]] ; then
    time_end
  fi
}

function snaps {
  if [[ "$cmd" != "snaps" ]] ; then
    rm -rf "$lock"
  fi
  rescript_lock
  trap 'prev_cmd=$this_cmd; this_cmd=$BASH_COMMAND' DEBUG
  if [[ "$cmd" = "snaps" ]] ; then
    logger
    time_start
  fi
  debug_start
  restic snapshots --compact ${rest[@]}
  latest_cmd=$prev_cmd cmd_error="$?"
  debug_stop
  latest_error
  if [[ "$cmd" = "snaps" ]] ; then
    time_end
  fi
}

function time_start {
  if [[ ! "$cmd" ]] ; then
    title="S T A R T I N G    B A C K U P"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
    echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""System:""$endcolor" "$(opsys)"
