	  elif [[ "$HOURS" -gt "0" ]] ; then
	    echo -e "$YELLOW""[Next check and cleanup in $HOURS hours and $MINUTES minutes...]""$ENDCOLOR"
	  elif [[ "$MINUTES" -gt "0" ]] ; then
	    echo -e "$YELLOW""[Next check and cleanup in $MINUTES minutes...]""$ENDCOLOR"
	  else
	    echo -e "$YELLOW""[Repo will be checked and cleaned in the next run...]""$ENDCOLOR"
	  fi
	fi
	echo -e "----------------------------------------------------------------------"
	echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
	HRS=$((SECONDS / 3600))
	MIN=$(((SECONDS / 60) % 60))
	SEC=$((SECONDS % 60))
	if [[ "$HRS" -gt "0" ]] ; then
	  echo -e "$YELLOW""Duration:""$ENDCOLOR" "$HRS hours $MIN minues $SEC seconds"
	elif [[ "$MIN" -gt "0" ]] ; then
	  echo -e "$YELLOW""Duration:""$ENDCOLOR" "$MIN minutes $SEC seconds"
	else
	  echo -e "$YELLOW""Duration:""$ENDCOLOR" "$SEC seconds"
	fi
	echo -e "======================================================================"
	echo -e "| - - - - - - - - > [ C L E A N U P    E N D E D ] < - - - - - - - - |"
	echo -e "======================================================================"
  else
	echo -e "$YELLOW""You have not indicated any policy value...""$ENDCOLOR"
	echo "If you want to use [cleanup] option you need to set the [KEEP] variables."
	echo "For more information about the Usage check out the following link:"
	echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function cleanup-next {
  if [[ -z "$CLEAN" || "$CLEAN" -lt "1" ]] ; then
    echo -e "$YELLOW""You have not indicated any policy for the CLEAN value...""$ENDCOLOR"		  echo "The scrip will run check, forget and prune every time it runs"
    echo "unless you change the CLEAN variable at the beginning of this script."
    echo "The number indicated in the CLEAN variable must be in days."
    echo "For more information about the usage check out the following link:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  else
    NOW=$(date +"%s")
    NEXT=$(date -f "$HOME/.rescript/config/"$REPO"-datefile" "+%s")
    RESULT=$((NEXT-NOW))
    DAYS=$((RESULT / 86400))
    HOURS=$(((RESULT / 3600) % 24))
    MINUTES=$(((RESULT / 60) % 60))
    if [[ "$DAYS" -gt "0" ]] ; then
      echo -e "$YELLOW""Next cleanup and check in $DAYS days $HOURS hours and $MINUTES minutes...""$ENDCOLOR"
    elif [[ "$HOURS" -gt "0" ]] ; then
      echo -e "$YELLOW""Next cleanup and check in $HOURS hours and $MINUTES minutes...""$ENDCOLOR"
    elif [[ "$MINUTES" -gt "0" ]] ; then
      echo -e "$YELLOW""Next cleanup and check in $MINUTES minutes...""$ENDCOLOR"
    else
      echo -e "$YELLOW""Repo will be cleaned and checked in the next run...""$ENDCOLOR"
    fi
  fi
}

function logs {
  if [[ "$FLAG" == "--cat" ]] ; then
    if [[ "$LOGFILE" ]] ; then
      cat $HOME/.rescript/logs/"$LOGFILE"
    else
      echo "No log file indicated..."
      exit
    fi
  elif [[ "$FLAG" == "--help" ]] ; then
    logs-help
  elif [[ "$FLAG" == "--list" ]] ; then
    if ls $HOME/.rescript/logs/"$REPO"-* 1> /dev/null 2>&1 ; then
      ls $HOME/.rescript/logs/ | grep -e "$REPO"
      echo ""
      echo "Your logs are saved at $HOME/.rescript/logs"
    else
      echo "There are no log files to list for ["$REPO"]."
    fi
  elif [[ "$FLAG" == "--remove" ]] ; then
    if ls $HOME/.rescript/logs/"$REPO"-* 1> /dev/null 2>&1 ; then
      rm -rf $HOME/.rescript/logs/"$REPO"-*
      echo "Log files removed for ["$REPO"]."
    else
      echo "There are no log files to remove for ["$REPO"]." 
    fi
  fi
}

function mounter {
  if [ -e "$LOCK" ]; then
    echo -e "WARNING: "$REPO" repo is already running..."
    echo -e "If you are sure "$REPO" is not running, type"
    echo -e " "
    echo -e "	rescript "$REPO" unlock"
    echo -e " "
    echo -e "This will remove the lock for "$REPO""
    exit
  fi
  touch "$LOCK"
  trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
  mkdir "$RMOUNT"
  restic mount "$RMOUNT"
  rm -rf "$RMOUNT"
}

function random-check {
  LOG="$HOME/.rescript/logs/"$REPO"-check-random-log-$(date +%Y-%m-%d-%H:%M)"
  if [ -e "$LOCK" ]; then
    echo -e "WARNING: "$REPO" repo is already running..."
    echo -e "If you are sure "$REPO" is not running, type"
    echo -e " "
    echo -e "	rescript "$REPO" unlock"
    echo -e " "
    echo -e "This will remove the lock for "$REPO""
    exit
  fi
  touch "$LOCK"
  trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
  if [[ "$LOGGER" ]] ; then
    if [[ "$LOGGER" == "--log" ]] ; then
      exec > >(tee -a "$LOG") 2>&1
    else
      echo "Invalid flag ["$LOGGER"]..."
      echo ""
      echo "Usage:"
      echo "  rescript "$REPO" check --random"
      echo "OR"
      echo "  rescript "$REPO" check --random --log"
      echo ""
      echo "NOTE:"
      echo "If [--random] flag is used, you can't combine"
      echo "other restic flags; the only flag available after"
      echo "[--random] is [--log] flag if you want to create a"
      echo "log for this specific process."
      exit
    fi
  else
    echo > /dev/null
  fi
  restic check --read-data-subset $(($RANDOM % 10 + 1))/10
}

function restorer {
  LOG="$HOME/.rescript/logs/"$REPO"-restorer-log-$(date +%Y-%m-%d-%H:%M)"
  if [ -e "$LOCK" ]; then
    echo -e "WARNING: "$REPO" repo is already running..."
    echo -e "If you are sure "$REPO" is not running, type"
    echo -e " "
    echo -e "	rescript "$REPO" unlock"
    echo -e " "
    echo -e "This will remove the lock for "$REPO""
    exit
  fi
  touch "$LOCK"
  trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
  if [[ "$LOGGER" ]] ; then
    if [[ "$LOGGER" == "--log" ]] ; then
      exec > >(tee -a "$LOG") 2>&1
    else
      echo "Invalid flag ["$LOGGER"]..."
      echo ""
      restorer-help
      exit
    fi
  else
    echo > /dev/null
  fi
  if [[ "$FLAG" == "--host" ]] ; then
    RESTIC_RESTORE="$HOME/restore-latest-host-"$HPT"-$(date +%s)"
  elif [[ "$FLAG" == "--path" ]] ; then
    RESTIC_RESTORE="$HOME/restore-latest-by-path-$(date +%s)"
  elif [[ "$FLAG" == "--tag" ]] ; then
    RESTIC_RESTORE="$HOME/restore-latest-tag-"$HPT"-$(date +%s)"
  else
    RESTIC_RESTORE="$HOME/restore-"$SID"-$(date +%s)"
  fi
  if [[ "$FLAG" ]] ; then
    echo -e "======================================================================"
    echo -e "|- - - - - - - > [ S T A R T I N G    R E S T O R E ] < - - - - - - -|"
    echo -e "======================================================================"
    echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""System:""$ENDCOLOR" "$(cat /etc/issue.net) $(uname -o) $(uname -r)"
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
    else
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    echo -e "----------------------------------------------------------------------"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Restoring latest snapshot for ["$HPT"] from:""$ENDCOLOR" "$DESTINATION..."
    else
      echo -e "$YELLOW""Restoring latest snapshot for ["$HPT"] from:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    restic restore latest --target "$RESTIC_RESTORE" "$FLAG" "$HPT" --verify
    echo -e "----------------------------------------------------------------------"
    echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    HRS=$((SECONDS / 3600))
    MIN=$(((SECONDS / 60) % 60))
    SEC=$((SECONDS % 60))
    if [[ "$HRS" -gt "0" ]] ; then
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$HRS hours $MIN minues $SEC seconds"
    elif [[ "$MIN" -gt "0" ]] ; then
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$MIN minutes $SEC seconds"
    else
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$SEC seconds"
    fi
    echo -e "======================================================================"
    echo -e "| - - - - - - > [ R E S T O R E    C O M P L E T E D ] < - - - - - - |"
    echo -e "======================================================================"
  else
    echo -e "======================================================================"
    echo -e "|- - - - - - - > [ S T A R T I N G    R E S T O R E ] < - - - - - - -|"
    echo -e "======================================================================"
    echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""System:""$ENDCOLOR" "$(cat /etc/issue.net) $(uname -o) $(uname -r)"
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
    else
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    echo -e "----------------------------------------------------------------------"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Restoring snapshot ["$SID"] from:""$ENDCOLOR" "$DESTINATION..."
    else
      echo -e "$YELLOW""Restoring snapshot ["$SID"] from:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    restic restore "$SID" --target "$RESTIC_RESTORE" --verify
    echo -e "----------------------------------------------------------------------"
    echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    HRS=$((SECONDS / 3600))
    MIN=$(((SECONDS / 60) % 60))
    SEC=$((SECONDS % 60))
    if [[ "$HRS" -gt "0" ]] ; then
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$HRS hours $MIN minues $SEC seconds"
    elif [[ "$MIN" -gt "0" ]] ; then
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$MIN minutes $SEC seconds"
    else
      echo -e "$YELLOW""Duration:""$ENDCOLOR" "$SEC seconds"
    fi
    echo -e "======================================================================"
    echo -e "| - - - - - - > [ R E S T O R E    C O M P L E T E D ] < - - - - - - |"
    echo -e "======================================================================"
  fi  
}

function unlocker {
  if [[ ! -e "$LOCK" ]]; then
    echo "No locks found..."
  else
    rm -rf "$LOCK"
    echo "Script unlocked..."
  fi
}

# ============================================================== #
# Call Commands and Functions					 #
# ============================================================== #
if [[ "$2" == "" ]] ; then
  automatic
  exit
elif [[ "$2" == "backup" ]] ; then
  if [[ "$3" == "--help" ]] ; then
    backup-help
    exit
  else
    LOGGER="$3"
    backup
    exit
  fi
elif [[ "$2" == "check" ]] ; then
  if [[ "$3" == "--random" ]] ; then
    LOGGER="$4"
    random-check
  else
    if [ -e "$LOCK" ]; then
      echo -e "WARNING: "$REPO" repo is already running..."
      echo -e "If you are sure "$REPO" is not running, type"
      echo -e " "
      echo -e "	rescript "$REPO" unlock"
      echo -e " "
      echo -e "This will remove the lock for "$REPO""
      exit
    fi
    touch "$LOCK"
    trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
    restic "${@:2}"
  fi
elif [[ "$2" == "cleanup" ]] ; then
  if [[ "$3" == "--help" ]] ; then
    cleanup-help
    exit
  elif [[ "$3" == "--next" ]] ; then
    cleanup-next
    exit
  else
    LOGGER="$3"
    cleanup
    exit
  fi
elif [[ "$2" == "logs" ]] ; then
  if [[ ! "$3" ]] ; then
    echo "You have not indicated any option."
    echo ""
    logs-help
    exit
  else
    REPO="$1"
    FLAG="$3"
    LOGFILE="$4"
    logs
    exit
  fi
elif [[ "$2" == "mounter" ]] ; then
  if [[ "$3" == "--help" ]] ; then
    mounter-help
    exit
  else
    mounter
    exit
  fi
elif [[ "$2" == "restorer" ]] ; then
  if [[ ! "$3" ]] ; then
    echo "You have not indicated any [snapshot-ID] to restore."
    echo ""
    restorer-help
    exit
  elif [[ "$3" == "--help" ]] ; then
    restorer-help
    exit
  elif [[ "$3" == "--host" || "$3" == "--path" || "$3" == "--tag" ]] ; then
    if [[ ! "$4" ]] ; then
      echo "No ["$3"] indicated."
      echo ""
      restorer-help
      exit
    else
      FLAG="$3"
      HPT="$4"
      LOGGER="$5"
      restorer
      exit
    fi
  else
    SID="$3"
    LOGGER="$4"
    restorer
  fi
elif [[ "$2" == "unlocker" ]] ; then
  if [[ "$3" == "--help" ]] ; then
    unlocker-help
    exit
  else
    unlocker
    exit
  fi
else
  if [ -e "$LOCK" ]; then
    echo -e "WARNING: "$REPO" repo is already running..."
    echo -e "If you are sure "$REPO" is not running, type"
    echo -e " "
    echo -e "	rescript "$REPO" unlock"
    echo -e " "
    echo -e "This will remove the lock for "$REPO""
    exit
  fi
  touch "$LOCK"
  trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
  restic "${@:2}"
fi
