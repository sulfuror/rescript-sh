function build_exclusions {
  echo "======================"
  echo "    Build Options     "
  echo "======================"
  echo " [1] For Home Dir     "
  echo " [2] For System Dir   "
  echo " [3] Back             "
  echo " [4] Exit             "
  echo "======================"
  read -p "Select an option and press Enter [ 1 - 4 ]: " excl_bld
  if [[ "$excl_bld" == "1" || "$excl_bld" == "Home" ||"$excl_bld" == "home" ]] ; then
    clear
    echo "======================"
    echo " Exclusion Files List "
    echo "======================"
    echo " [1] Back             "
    echo " [2] Exit             "
    echo "----------------------"    
    ls $HOME/.rescript/config | grep -e '-exclusions' | sed -e 's/\-exclusions$//'
    echo "======================"
    read -p "Type the name of the exclusion file you want to build or one of the options above [ 1 - 2 ]: " excl_file
    if [[ "$excl_file" == "1" || "$excl_file" == "Back" || "$excl_file" == "back" ]] ; then
      clear
      build_exclusions
    elif [[ "$excl_file" == "2" || "$excl_file" == "Exit" || "$excl_file" == "exit" ]] ; then
      echo "Exiting..."
      exit
    elif [[ -e "$HOME/.rescript/config/$excl_file-exclusions" ]] ; then 
      echo "This action will override your existing [$excl_file] exclusion file."
      read -p "Are you sure you want to proceed? y/n: " ans_excl
      if [[ "$ans_excl" == "yes" || "$ans_excl" == "y" || "$ans_excl" == "Yes" || "$ans_excl" == "Y" || "$ans_excl" == "YES" ]] ; then
        if [[ "$excl_file" == "1" || "$excl_file" == "Back" || "$excl_file" == "back" ]] ; then
