function automatic {
  LOG="$HOME/.rescript/logs/"$REPO"-log-$(date +%Y-%m-%d-%H:%M)"
  rescript-lock
  if [[ "$LOGGING" == "yes" || "$LOGGING" == "YES" || "$LOGGING" == "Y" || "$LOGGING" == "y" ]] ; then
    exec > >(tee -a "$LOG") 2>&1
  elif [[ "$LOGGING" == "no" || "$LOGGING" == "NO" || "$LOGGING" == "N" || "$LOGGING" == "n" ]] ; then
    echo > /dev/null
  fi
  echo -e "=========================================================================="
  echo -e "| - - - - - - - - > [ S T A R T I N G    B A C K U P ] < - - - - - - - - |"
  echo -e "=========================================================================="
  echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
  echo -e "$YELLOW""System:""$ENDCOLOR" "$(opsys)"
  if [[ "$HOST" ]] ; then
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOST"
  else
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
  fi
  if [[ "$DESTINATION" ]] ; then
    echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
  else
    echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
  fi
  echo -e "--------------------------------------------------------------------------"

  # Backup and exclusions
  echo -e "$YELLOW""[Taking a Snapshot...]""$ENDCOLOR"
  restic backup $BACKUP_DIR --verbose --exclude-caches --exclude-file="$EXCLUDES" $RESTIC_TAG $RESTIC_HOST

  EXCLUSIONS=$(grep -E -v -n -c '(^#|^\s*$|^\s*\t*#)' "$EXCLUDES")
  echo -e "$YELLOW""There are $EXCLUSIONS exclusion rules...""$ENDCOLOR"

  echo -e "--------------------------------------------------------------------------"
  # Snapshot List
  echo -e "$YELLOW""[Snapshots List...]""$ENDCOLOR"
  restic snapshots

  # Check and Clean Repo Based on User's Policy
  if [[ -f "$HOME/.rescript/config/"$REPO"-datefile" || "$CLEAN" -gt "0" ]]; then
    if [[ ! -f "$HOME/.rescript/config/"$REPO"-datefile" ]] ; then
      touch "$HOME/.rescript/config/"$REPO"-datefile"
    fi
    if [[ "$(uname -s)" == "Linux" || "$(uname -s)" == "GNU" ]] ; then
      NOW=$(date +"%s")
      NEXT=$(date -f "$HOME/.rescript/config/"$REPO"-datefile" "+%s")
    elif [[ "$(uname -s)" == "Darwin"* || "$(uname -s)" == "FreeBSD"* ]] ; then
      NOW=$(gdate +"%s")
      NEXT=$(gdate -f "$HOME/.rescript/config/"$REPO"-datefile" "+%s")
    fi
    if [[ "$NOW" -lt "$NEXT" ]] ; then
      cleanup-next
    else 
      if [[ ! -z "$POLICIES" ]] ; then
        echo -e "$YELLOW""[Cleaning Repo...]""$ENDCOLOR"
        restic forget "${POLICIES[@]}"
        restic prune
        echo -e "$YELLOW""[Checking for Errors in Repo...]""$ENDCOLOR"
        restic check --cleanup-cache
        if [[ "$CLEAN" -gt "0" ]] ; then
          if [[ "$CLEAN" == "1" ]] ; then
            D="day"
          else
            D="days"
          fi
          echo -e "$YELLOW""[Done Cleaning; Next Cleanup and Check Will Be Done in $CLEAN $D...]""$ENDCOLOR"
          if [[ "$(uname -s)" == "Linux" || "$(uname -s)" == "GNU" ]] ; then
            date -d now+"$CLEAN"days > "$HOME/.rescript/config/"$REPO"-datefile"
          elif [[ "$(uname -s)" == "Darwin"* || "$(uname -s)" == "FreeBSD"* ]] ; then
            gdate -d now+"$CLEAN"days > "$HOME/.rescript/config/"$REPO"-datefile"
          fi
        fi
      fi
    fi
  else 
      if [[ ! -z "$POLICIES" ]] ; then
        echo -e "$YELLOW""[Cleaning Repo...]""$ENDCOLOR"
        restic forget "${POLICIES[@]}"
        restic prune
        echo -e "$YELLOW""[Checking for Errors in Repo...]""$ENDCOLOR"
        restic check --cleanup-cache
      fi
  fi

  # Stats
  echo -e "--------------------------------------------------------------------------"
  echo -e "$YELLOW""[Original Size for Latest Snapshot...]""$ENDCOLOR"
  restic stats --host "" latest
  echo -e "$YELLOW""[Deduplicated Size for Latest Snapshot...]""$ENDCOLOR"
  restic stats --mode raw-data --host "" latest
  echo -e "$YELLOW""[Original Size for All Snapshots...]""$ENDCOLOR"
  restic stats
