# Configuration menu
function config_menu {
  echo "======================"
  echo "       Options        "
  echo "======================"
  echo " [1] Edit Existing    "
  echo " [2] New Repository   "
  echo " [3] Delete Config    "
  echo " [4] Back to Main Menu"
