    echo "You have selected [Gedit] as your default text editor."
  elif [[ "$texteditor" == "4" || "$texteditor" == "Mousepad" || "$texteditor" == "mousepad" ]] ; then
    echo "mousepad" > $HOME/.rescript/config/.editor
