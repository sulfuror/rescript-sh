function automatic {
  LOG="$HOME/.rescript/logs/"$REPO"-log-$(date +%Y-%m-%d-%H:%M)"
  if [ -e "$LOCK" ]; then
    echo -e "WARNING: "$REPO" repo is already running..."
    echo -e "If you are sure "$REPO" is not running, type"
    echo -e " "
    echo -e "	rescript "$REPO" unlock"
    echo -e " "
    echo -e "This will remove the lock for "$REPO""
    exit
  fi
  touch "$LOCK"
  trap 'rm -rf "$LOCK"' INT QUIT TERM EXIT
  if [[ "$LOGGING" == "yes" || "$LOGGING" == "YES" || "$LOGGING" == "Y" || "$LOGGING" == "y" ]] ; then
    exec > >(tee -a "$LOG") 2>&1
  elif [[ "$LOGGING" == "no" || "$LOGGING" == "NO" || "$LOGGING" == "N" || "$LOGGING" == "n" ]] ; then
    echo > /dev/null
  fi
  echo -e "=========================================================================="
  echo -e "| - - - - - - - - > [ S T A R T I N G    B A C K U P ] < - - - - - - - - |"
  echo -e "=========================================================================="
  echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
  echo -e "$YELLOW""System:""$ENDCOLOR" "$(opsys)"
  if [[ "$HOST" ]] ; then
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOST"
  else
    echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
  fi
  if [[ "$DESTINATION" ]] ; then
    echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
  else
    echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
  fi
  echo -e "--------------------------------------------------------------------------"

  # Backup and exclusions
  echo -e "$YELLOW""[Taking a Snapshot...]""$ENDCOLOR"
  restic backup "$BACKUP_DIR" --tag "$TAG" --verbose --exclude-caches --exclude-file="$EXCLUDES"  --host "$HOST"

  EXCLUSIONS=$(grep -E -v -n -c '(^#|^\s*$|^\s*\t*#)' "$EXCLUDES")
  echo -e "$YELLOW""There are $EXCLUSIONS exclusion rules...""$ENDCOLOR"

  echo -e "--------------------------------------------------------------------------"
  # Snapshot List
  echo -e "$YELLOW""[Snapshots List...]""$ENDCOLOR"
  restic snapshots

  # Check and Clean Repo Based on User's Policy
  if [[ -f "$HOME/.rescript/config/"$REPO"-datefile" || "$CLEAN" -gt "0" ]]; then
    if [[ "$(uname -s)" == "Linux" || "$(uname -s)" == "GNU" ]] ; then
      NOW=$(date +"%s")
      NEXT=$(date -f "$HOME/.rescript/config/"$REPO"-datefile" "+%s")
    elif [[ "$(uname -s)" == "Darwin"* || "$(uname -s)" == "FreeBSD"* ]] ; then
      NOW=$(gdate +"%s")
      NEXT=$(gdate -f "$HOME/.rescript/config/"$REPO"-datefile" "+%s")
    fi
    RESULT=$((NEXT-NOW))
    DAYS=$((RESULT / 86400))
    HOURS=$(((RESULT / 3600) % 24))
    MINUTES=$(((RESULT / 60) % 60))
    if [[ "$DAYS" == "1" ]] ; then
      D="day"
    else
      D="days"
    fi
    if [[ "$HOURS" == "1" ]] ; then
      H="hour"
    else
      H="hours"
    fi
    if [[ "$MINUTES" == "1" ]] ; then
      M="minute"
    else
      M="minutes"
    fi
    if [[ "$NOW" -lt "$NEXT" ]] ; then
      if [[ "$DAYS" -gt "0" ]] ; then
        echo -e "$YELLOW""[Next cleanup and check in $DAYS $D $HOURS $H and $MINUTES $M...]""$ENDCOLOR"
      elif [[ "$HOURS" -gt "0" ]] ; then
        echo -e "$YELLOW""[Next cleanup and check in $HOURS $H and $MINUTES $M...]""$ENDCOLOR"
      elif [[ "$MINUTES" -gt "0" ]] ; then
        echo -e "$YELLOW""[Next cleanup and check in $MINUTES $M...]""$ENDCOLOR"
      else
        echo -e "$YELLOW""[Repo will be cleaned and checked in the next run...]""$ENDCOLOR"
      fi
    else 
      if [[ "$KEEP_LAST" -gt "0" || "$KEEP_HOURLY" -gt "0" || "$KEEP_DAILY" -gt "0" || "$KEEP_WEEKLY" -gt "0" || "$KEEP_MONTHLY" -gt "0" || "$KEEP_YEARLY" -gt "0" ]] ; then
        echo -e "$YELLOW""[Cleaning Repo...]""$ENDCOLOR"
        restic forget --keep-last $KEEP_LAST --keep-hourly $KEEP_HOURLY --keep-daily $KEEP_DAILY --keep-weekly $KEEP_WEEKLY --keep-monthly $KEEP_MONTHLY --keep-yearly $KEEP_YEARLY
        restic prune
        echo -e "$YELLOW""[Checking for Errors in Repo...]""$ENDCOLOR"
        restic check --cleanup-cache
        if [[ "$CLEAN" -gt "0" ]] ; then
          if [[ "$CLEAN" == "1" ]] ; then
            D="day"
          else
            D="days"
          fi
          echo -e "$YELLOW""[Done Cleaning; Next Cleanup and Check Will Be Done in $CLEAN $D...]""$ENDCOLOR"
          if [[ "$(uname -s)" == "Linux" || "$(uname -s)" == "GNU" ]] ; then
            date -d now+"$CLEAN"days > "$HOME/.rescript/config/"$REPO"-datefile"
          elif [[ "$(uname -s)" == "Darwin"* || "$(uname -s)" == "FreeBSD"* ]] ; then
            gdate -d now+"$CLEAN"days > "$HOME/.rescript/config/"$REPO"-datefile"
          fi
        fi
      fi
    fi
  else 
      if [[ "$KEEP_LAST" -gt "0" || "$KEEP_HOURLY" -gt "0" || "$KEEP_DAILY" -gt "0" || "$KEEP_WEEKLY" -gt "0" || "$KEEP_MONTHLY" -gt "0" || "$KEEP_YEARLY" -gt "0" ]] ; then
        echo -e "$YELLOW""[Cleaning Repo...]""$ENDCOLOR"
        restic forget --keep-last $KEEP_LAST --keep-hourly $KEEP_HOURLY --keep-daily $KEEP_DAILY --keep-weekly $KEEP_WEEKLY --keep-monthly $KEEP_MONTHLY --keep-yearly $KEEP_YEARLY
        restic prune
        echo -e "$YELLOW""[Checking for Errors in Repo...]""$ENDCOLOR"
        restic check --cleanup-cache
      fi
  fi

  # Stats
  echo -e "--------------------------------------------------------------------------"
  echo -e "$YELLOW""[Original Size for Latest Snapshot...]""$ENDCOLOR"
  restic stats --host "" latest
  echo -e "$YELLOW""[Deduplicated Size for Latest Snapshot...]""$ENDCOLOR"
  restic stats --mode raw-data --host "" latest
  echo -e "$YELLOW""[Original Size for All Snapshots...]""$ENDCOLOR"
  restic stats
  echo -e "$YELLOW""[Deduplicated Size for All Snapshots...]""$ENDCOLOR"
  restic stats --mode raw-data
  # Time and Runtime
  echo -e "--------------------------------------------------------------------------"
  echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
  echo -e "$YELLOW""Duration:""$ENDCOLOR" "$(duration)"
  echo -e "=========================================================================="
  echo -e "| - - - - - - - - - > [ B A C K U P      E N D E D ] < - - - - - - - - - |"
  echo -e "=========================================================================="
}

