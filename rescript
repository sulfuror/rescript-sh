# Main menu
function main_menu {
  echo "======================"
  echo "        Menu          "
  echo "======================"
  echo " [1] Configuration    "
  echo " [2] Exclusions       "
  echo " [3] Exit             "
  echo "======================"
  read -p "Select an option and press Enter [ 1 - 3 ]: " main
  if [[ "$main" == "1" || "$main" == "Configuration" || "$main" == "configuration" ]] ; then
    clear
    config_menu
  elif [[ "$main" == "2" || "$main" == "Exclusions" || "$main" == "exclusions" ]] ; then
    clear
    exclusion_menu    
  elif [[ "$main" == "3" || "$main" == "Exit" || "$main" == "exit" ]] ; then
    echo "Exiting..."
    exit    
  else
    clear
    echo "No valid option..."
    main_menu
  fi
}

# Configuration menu
function config_menu {
  echo "======================"
  echo "       Options        "
  echo "======================"
  echo " [1] Edit Existing    "
  echo " [2] New Repository   "
  echo " [3] Delete Config    "
  echo " [4] Back to Main Menu"
  echo " [5] Exit             "
  echo "======================"
  read -p "Select an option and press Enter [ 1 - 5 ]: " cfgopt
  if [[ "$cfgopt" == "1" || "$cfgopt" == "Edit" || "$cfgopt" == "edit" ]] ; then
    clear
    edit_config_files
  elif [[ "$cfgopt" == "2" || "$cfgopt" == "New" || "$cfgopt" == "new" ]] ; then
    new_config_file
  elif [[ "$cfgopt" == "3" || "$cfgopt" == "Delete" || "$cfgopt" == "delete" ]] ; then
    clear
    delete_config_file
  elif [[ "$cfgopt" == "4" || "$cfgopt" == "Back" || "$cfgopt" == "back" ]] ; then
    clear
    main_menu
  elif [[ "$cfgopt" == "5" || "$cfgopt" == "Exit" || "$cfgopt" == "exit" ]] ; then
    echo "Exiting..."
    exit
  else
    clear
    echo "No valid selection; try again..."
    config_menu
  fi
}

function edit_config_files {
  echo "======================"
  echo "     Config Files     "
  echo "======================"
  echo " [1] Back to Main Menu"
  echo " [2] Exit             "
  echo "----------------------"
  ls $HOME/.rescript/config | grep -e '.conf' | sed -e 's/\.conf$//'
  echo "======================"
  read -p "Write the name of the repo file to open or one of the options above [ 1 - 2 ]: " conf
  if [[ "$conf" == "1" || "$conf" == "Back" || "$conf" == "back" ]] ; then
    clear
    config_menu
  elif [[ "$conf" == "2" || "$conf" == "Exit" || "$conf" == "exit" ]] ; then
    echo "Exiting..."
    exit
  elif [[ -e $HOME/.rescript/config/$conf.conf ]] ; then
    "$EDITOR" $HOME/.rescript/config/$conf.conf 2> /dev/null
    clear
    edit_config_files
  else
    clear
    echo "There is no repo called ["$conf"]; try again with the correct name."
    edit_config_files
  fi
}  

