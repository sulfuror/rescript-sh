function install {
  if [[ -d "$HOME/bin" ]] ; then
    cp $(basename "$0") "$HOME/bin/$(basename "$0")"
    chmod 700 "$HOME/bin/$(basename "$0")"
    echo "The script was moved to "$HOME/bin" directory."
    exit
  elif [[ -d "$HOME/.local/bin" ]] ; then
    cp $(basename "$0") "$HOME"/.local/bin/$(basename "$0")
    chmod 700 "$HOME/.local/bin/$(basename "$0")"
    echo "The script was moved to "$HOME/.local/bin" directory."
    exit
  else
    echo "There is no [/bin] directory present in your "$HOME" directory."
    read -p "Do you wish to create a [/bin] directory? y/n: " installation
    if [[ "$installation" == "Yes" || "$installation" == "yes" || "$installation" == "y" || "$installation" == "YES" || "$installation" == "Y" ]] ; then
      mkdir -p "$HOME/.local/bin"
      cp $(basename "$0") "$HOME/.local/bin/$(basename "$0")"
      chmod 700 "$HOME/.local/bin/$(basename "$0")"
      echo "The script was moved to "$HOME/.local/bin" directory."
      exit
    elif [[ "$installation" == "No" || "$installation" == "no" || "$installation" == "n" || "$installation" == "NO" || "$installation" == "N" ]] ; then
      echo "Exiting..."
      exit
    else
      echo "No action indicated; exiting..."
      exit
    fi
  fi
}

function update {
	wget -O .rescript-latest https://gitlab.com/sulfuror/rescript.sh/raw/master/rescript 2> /dev/null

	if [[ "$(sed '3!d' $(which rescript))" == "$(sed '3!d' .rescript-latest)" ]] ; then
	  rm .rescript-latest
	  echo "You're already running the latest version!"
	  echo "$(rescript version)"
	else
	  chmod 755 .rescript-latest
	  read -p "$(./.rescript-latest version) is available; do you want to install it? (y/n):" updater
	  if [[ "$updater" == "y" || "$updater" == "Y" || "$updater" == "yes" || "$updater" == "YES" ]] ; then
  	  if [[ $(which rescript) == /usr/bin/rescript || $(which rescript) == /bin/rescript || $(which rescript) == /usr/local/bin/rescript ]] ; then
	      if [[ $USER == root ]] ; then
	        mv .rescript-latest $(which rescript)
	        echo "Rescript have been updated to the latest version!"
  	      echo "$(rescript version)"
	      else
	        rm .rescript-latest
	        echo "Rescript is located at $(which rescript)."
	        echo "To update in this location you need to run [update] again with [sudo]:"
  	      echo ""
	        echo "  sudo rescript udpate"
	        echo "" 
	        echo "Nothing done... exiting."
	        exit
  	    fi
	    else
	      chmod +x .rescript-latest
	      mv .rescript-latest $(which rescript)
  	    echo "Rescript have been updated to the latest version!"
	      echo "$(rescript version)"
	    fi
	  else
	    echo "Nothing done... exiting."
	    exit
	  fi
	fi
}

