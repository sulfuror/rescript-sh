fi
if [[ ! -z "$KEEP_TAG" ]] ; then
  forget_tag="--keep-tag $KEEP_TAG"
fi
if [[ "$KEEP_ARCHIVE" = "yes" ]] ; then
  keep_archive="--keep-tag archive"
fi
policies=(
  $forget_last
  $forget_hourly
  $forget_daily
  $forget_weekly
  $forget_monthly
  $forget_yearly
  $forget_within
  $forget_tag
  $keep_archive
)

if [[ ! -z "$HOST" ]] ; then
  restic_host="--host $HOST"
fi
if [[ ! -z "$TAG" ]] ; then
  restic_tag="--tag $TAG"
fi

function archive {
  if [[ ! $(which rsync) ]] ; then
    echo "***$(basename "$0") warning***"
    echo "[rsync] not found..."
    echo ""
    echo "[$cmd] works with [rsync] to merge data into one directory."
    echo "Please, install [rsync] to proceed."
    exit
  fi
  shopt -u nocasematch
  rescript-lock
  case "$cmd" in
    backup|cleanup)
      if [[ ! -z "$HOST" ]] ; then
        host_archive="$HOST"
      else
        host_archive="$(hostname)"
      fi
      echo "Starting archive..."
      ;;
    *)
      if [[ "$flags" ]] ; then
        case "$flags" in
          -h|--help)
            archive-help
            exit
            ;;
          -H|--host)
            if [[ ! "$opt" ]] ; then
              echo "No [host] indicated."
              echo ""
              archive-help
              exit
            elif [[ "$(restic snapshots --compact --host "$opt" | tail -1 | awk '{print $1}')" = "0" ]] ; then
              echo "There is no host named [$opt] in your repository."
              exit
            fi
            host_archive="$opt"
            ;;
          *)
            echo "Invalid option [$flags]..."
            exit
            ;;
        esac
      elif [[ ! -z "$HOST" ]] ; then
        host_archive="$HOST"
      else
        host_archive="$(hostname)"
      fi
      ;;
  esac
  if [[ "$(restic snapshots --compact --host "$host_archive" | tail -1 | awk '{print $1}')" -lt "2" ]] ; then
    echo "There is only $(restic snapshots --compact --host "$host_archive" | tail -1 | awk '{print $1}') snapshot available."
    exit
  fi
  if [[ "$(restic snapshots --compact --host "$host_archive" | tail -1 | awk '{print $1}')" = "2" && "$(restic snapshots --compact --host "$host_archive" --tag "archive" --path "/tmp/archive" | tail -1 | awk '{print $1}')" -gt "0" ]] ; then
    echo "There are no files to archive..."
    exit
  fi
  if [[ -d "/tmp" ]] ; then
    tmp_dir="/tmp"
  else
    tmp_dir="$TMPDIR"
  fi
  echo -ne 'Checking for files to archive: [########                ](33%)\r'
  prevsnap=$(restic snapshots --compact --host "$host_archive" | tail -4 | head -1 | awk '{print $1}')
  echo -ne 'Checking for files to archive: [################        ](66%)\r'
  latesnap=$(restic snapshots --compact --host "$host_archive" | tail -3 | head -1 | awk '{print $1}')
  case "$(uname -s)" in
    Darwin)
      rescript_archive="$tmp_dir/$(gtr -dc '0-9A-Z' < /dev/urandom | head -c 40)"
      ;;
    *)
      rescript_archive="$tmp_dir/$(tr -dc '0-9A-Z' < /dev/urandom | head -c 40)"
      ;;
  esac
  archiver="$tmp_dir/archive"
  archiver_latest="$tmp_dir/archive_latest"
  archiver_old="$tmp_dir/archive_old"
  restic diff "$prevsnap" "$latesnap" | grep -e '-    /' | sed -e 's/^-    //g' > "$rescript_archive"
  echo -ne 'Checking for files to archive : [########################](100%)\r'
  echo -ne '\n'
  wait
  if [[ ! -s "$rescript_archive" ]] ; then
    rm -rf "$rescript_archive" >> /dev/null 2>&1
    echo "There are no files to archive..."
  else
    if [[ "$(grep -c "/" "$rescript_archive")" = "1" ]] ; then
      echo "There is $(grep -c "/" "$rescript_archive") file deleted from the latest snapshot:"
    else
      echo "There are $(grep -c "/" "$rescript_archive") files deleted from the latest snapshot:"
    fi
    cat -n "$rescript_archive"
    echo -ne 'Restoring deleted files       : [#####                   ](20%)\r'
    eval filter="( $(sed 's/ \+/\\ /g' < "$rescript_archive" | sed 's/^/--include="/' | sed 's/$/"/') )"
    wait
    restic restore "${filter[@]}" --verify "$prevsnap" -t "$archiver_latest" >> /dev/null 2>&1 &
    wait
    echo -ne 'Restoring deleted files       : [##########              ](40%)\r'
    restic restore --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" --verify latest -t "$archiver_old" >> /dev/null 2>&1
    wait
    echo -ne 'Restoring deleted files       : [###############         ](60%)\r'
    restic forget --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" --keep-last="1" >> /dev/null 2>&1
    wait
    echo -ne 'Restoring deleted files       : [####################    ](80%)\r'
    restic forget --host "$host_archive" --tag "archive" --path "$tmp_dir/archive" latest >> /dev/null 2>&1
    wait
    echo -ne 'Restoring deleted files       : [########################](100%)\r'
    echo -ne '\n'
    if [[ -d "$archiver_old" ]] ; then
      echo -ne 'Merging data                  : [########                ](33%)\r'
      rsync -a $archiver_old/tmp/archive/* $archiver >> /dev/null 2>&1
      wait
      echo -ne 'Merging data                  : [################        ](66%)\r'
      rsync -a $archiver_latest/* $archiver >> /dev/null 2>&1
      wait
      echo -ne 'Merging data                  : [########################](100%)\r'
      echo -ne '\n'
    else
      echo -ne 'Merging data                  : [############            ](50%)\r'
      rsync -a $archiver_latest/* $archiver >> /dev/null 2>&1
      wait
      echo -ne 'Merging data                  : [########################](100%)\r'
      echo -ne '\n'
    fi
    echo -ne 'Archiving deleted files       : [############            ](50%)\r'
    restic backup --time "2015-$(date +%m-%d) $(date +%H:%M:%S)" --tag archive --host "$host_archive" "$archiver" >> /dev/null 2>&1
    wait
    { rm -rf "$rescript_archive"; rm -rf "$archiver"; rm -rf "$archiver_latest"; rm -rf "$archiver_old"; } >> /dev/null 2>&1
    echo -ne 'Archiving deleted files       : [########################](100%)\r'
    echo -ne '\nArchive Completed!\n'
  fi
}

function automatic {
  rescript-lock
  case "$LOGGING" in
    y|yes)
      logger
      ;;
  esac
  time-start
  # Backup
  case "$SKIP_OFFICE" in
    y|yes)
      echo -e "$yellow""[Taking a Snapshot...]""$endcolor"
      restic backup $BACKUP_DIR --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host --exclude-file=<(find "$BACKUP_DIR" -iname ".~lock.*" 2> /dev/null | sed -e 's/.~lock.//g' | sed -e 's/#//g') --exclude=".~lock.*"
      ;;
    *)
      echo -e "$yellow""[Taking a Snapshot...]""$endcolor"
      restic backup $BACKUP_DIR --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host
      ;;
  esac
  exclusions=$(grep -E -v -n -c '(^#|^\s*$|^\s*\t*#)' "$excludes")
  if [[ "$exclusions" -gt "0" ]] ; then
    echo -e "$yellow""There are $exclusions exclusion rules...""$endcolor"
  fi
  printf "%$((80/1))s\n" "" | tr ' ' -
  # Snapshot List
  echo -e "$yellow""[Snapshots List...]""$endcolor"
  restic snapshots
  case "$ARCHIVE" in
    y|yes)
      echo -e "$yellow""[Starting archive...]""$endcolor"
      rm -rf "$lock"
      archive
      ;;
  esac
  # Check and Clean Repo Based on User's Policy
  if [[ -f "$config_dir/$repo-datefile" || "$CLEAN" -gt "0" ]]; then
    if [[ ! -f "$config_dir/$repo-datefile" ]] ; then
      touch "$config_dir/$repo-datefile"
    fi
    now_next
    if [[ "$now" -lt "$next" ]] ; then
      cleanup-next
    else 
      if [[ ! -z "${policies[*]}" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        restic forget "${policies[@]}"
        restic prune
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
        if [[ "$CLEAN" -gt "0" ]] ; then
          if [[ "$CLEAN" = "1" ]] ; then
            d="day"
          else
            d="days"
          fi
          echo -e "$yellow""[Done Cleaning; Next Cleanup and Check Will Be Done in $CLEAN $d...]""$endcolor"
          case "$(uname -s)" in
            Linux|GNU)
              date -d now+"$CLEAN"days > "$config_dir/$repo-datefile"
              ;;
            *)
              gdate -d now+"$CLEAN"days > "$config_dir/$repo-datefile"
              ;;
          esac
        fi
      fi
    fi
  else 
      if [[ ! -z "${policies[*]}" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        restic forget "${policies[@]}"
        restic prune
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
      fi
  fi
  # Stats
  printf "%$((80/1))s\n" "" | tr ' ' -
  if [[ ! -z "$HOST" ]] ; then
    stat_host="$HOST"
  else
    stat_host="$(hostname)"
  fi
  echo -e "$yellow""[Original Size for $stat_host Latest Snapshot...]""$endcolor"
  restic stats --host "$stat_host" latest
  echo -e "$yellow""[Deduplicated Size for $stat_host Latest Snapshot...]""$endcolor"
  restic stats --mode raw-data --host "$stat_host" latest
  echo -e "$yellow""[Original Size for All Snapshots...]""$endcolor"
  restic stats
  echo -e "$yellow""[Deduplicated Size for All Snapshots...]""$endcolor"
  restic stats --mode raw-data
  # Time and Runtime
  time-end
  if [[ "$CLEAN" -gt "0" && -z "${policies[*]}" ]] ; then
    if [[ "$CLEAN" = "1" ]] ; then
      d="day"
    else
      d="days"
    fi
    echo "[rescript] noted that your CLEAN variable is $CLEAN, so [rescript] assumes that"
    echo "you want to perform a 'cleanup' (forget, prune and check) every $CLEAN $d but"
    echo "it can't execute it if you have not set the KEEP variables; please set your"
    echo "desired KEEP values in order to perform the 'cleanup' every $CLEAN $d. If you"
    echo "don't want [rescript] to 'cleanup' your repo automatically every $CLEAN $d,"
    echo "just leave the CLEAN variable blank in your cofiguration file and this"
    echo "message will not appear again."
    echo ""
    echo "For more info about this subject:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function backup {
  rescript-lock
  if [[ "$flags" ]] ; then
    case "$flags" in
      -a|--archive)
        case "$opt" in
          -S|--skip-office)
            time-start
            restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host --exclude-file=<(find "$BACKUP_DIR" -iname ".~lock.*" 2> /dev/null | sed -e 's/.~lock.//g' | sed -e 's/#//g') --exclude=".~lock.*" $BACKUP_DIR
            rm -rf "$lock"
            archive
            time-end
            exit
            ;;
          [a-z]*|-*|--*)
            echo "Invalid flag [$opt]..."
            echo ""
            backup-help
            exit
            ;;
          *)
            time-start
            restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host $BACKUP_DIR
            rm -rf "$lock"
            archive
            time-end
            exit
            ;;
        esac
        ;;
      -e|--exec)
        time-start
        restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host ${opt[@]} $BACKUP_DIR
        time-end
        exit
        ;;
      -d|--dry-run)
        if [[ "$opt" ]] ; then
          time-start
          echo 'This is a "dry-run" to display files and total size that would be added to'
          echo 'your repository. This actually does nothing in your repository. Size'
          echo 'displayed here and actual size once the data is in the repository'
          echo 'may vary due to restic deduplication.'
          echo ''
          du -hc $BACKUP_DIR ${opt[@]} 2> /dev/null
          time-end
        else
          time-start
          echo 'This is a "dry-run" to display files and total size that would be added to'
          echo 'your repository. This actually does nothing in your repository. Size'
          echo 'displayed here and actual size once the data is in the repository'
          echo 'may vary due to restic deduplication.'
          echo ''
          du -hc $BACKUP_DIR --exclude-from="$excludes" 2> /dev/null
          time-end
        fi
        exit
        ;;
      -h|--help)
        backup-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      -S|--skip-office)
        case "$opt" in
          -a|--archive)
            time-start
            restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host --exclude-file=<(find "$BACKUP_DIR" -iname ".~lock.*" 2> /dev/null | sed -e 's/.~lock.//g' | sed -e 's/#//g') --exclude=".~lock.*" $BACKUP_DIR
            rm -rf "$lock"
            archive
            time-end
            exit
            ;;
          [a-z]*|-*|--*)
            echo "Invalid flag [$opt]..."
            echo ""
            backup-help
            exit
            ;;
          *)
            time-start
            restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host --exclude-file=<(find "$BACKUP_DIR" -iname ".~lock.*" 2> /dev/null | sed -e 's/.~lock.//g' | sed -e 's/#//g') --exclude=".~lock.*" $BACKUP_DIR
            time-end
            exit
            ;;
        esac
        ;;
      *)
        echo "Invalid flag [$flags]..."
        echo ""
        backup-help
        exit
        ;;
    esac
  fi
  time-start
  restic backup --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host $BACKUP_DIR
  time-end
}

function changes {
  shopt -u nocasematch
  case "$flags" in
    -h|--help)
      changes-help
      exit
      ;;
    -H|--host|-p|--path|-T|--tag)
      case "$flags" in
        -H|--host)
          if [[ ! "$hpts" ]] ; then
            echo "No [host] indicated..."
            echo ""
            changes-help
            exit
          elif [[ "$(restic snapshots --compact --host "$hpts" | tail -1 | awk '{print $1}')" = "0" ]] ; then
            echo "There is no host named [$hpts] in your repository."
            exit
          fi
          restic_flag="--host"
          ;;
        -p|--path)
          if [[ ! "$hpts" ]] ; then
            echo "No [path] indicated..."
            echo ""
            changes-help
            exit
          elif [[ "$(restic snapshots --compact --path "$hpts" | tail -1 | awk '{print $1}')" = "0" ]] ; then
            echo "There is no snapshot with [$hpts] path in your repository."
            exit
          fi
          restic_flag="--path"
          ;;
        -T|--tag)
          if [[ ! "$hpts" ]] ; then
            echo "No [tag] indicated..."
            echo ""
            changes-help
            exit
          elif [[ "$(restic snapshots --compact --tag "$hpts" | tail -1 | awk '{print $1}')" = "0" ]] ; then
            echo "There is no [$hpts] tag in your repository."
            exit
          fi
          restic_flag="--tag"
          ;;
        *)
          echo "No valid option indicated..."
          echo ""
          changes-help
          exit
          ;;
      esac
      case "$opt" in
        -m|--metadata)
          previous_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -4 | head -1 | awk '{print $1}')
          latest_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -3 | head -1 | awk '{print $1}')
