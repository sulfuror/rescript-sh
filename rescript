        exit
      elif [[ "$FLAGS" == "--tag" || "$FLAGS" == "-t" ]] ; then
        echo "No [tag] indicated..."
        echo ""
        restorer-help
        exit
      fi
    fi
    echo -e "=========================================================================="
    echo -e "|- - - - - - - - > [ S T A R T I N G    R E S T O R E ] < - - - - - - - -|"
    echo -e "=========================================================================="
    echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""System:""$ENDCOLOR" "$(opsys)"
    if [[ "$HOST" ]] ; then
      echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOST"
    else
      echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
    fi
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
    else
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    echo -e "--------------------------------------------------------------------------"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Restoring latest snapshot for ["$HPTS"] from:""$ENDCOLOR" "$DESTINATION..."
    else
      echo -e "$YELLOW""Restoring latest snapshot for ["$HPTS"] from:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    restic restore latest --target "$RESTIC_RESTORE" "$FLAGS" "$HPTS" --verify
    echo -e "--------------------------------------------------------------------------"
    echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""Duration:""$ENDCOLOR" "$(duration)"
    echo -e "=========================================================================="
    echo -e "| - - - - - - - > [ R E S T O R E    C O M P L E T E D ] < - - - - - - - |"
    echo -e "=========================================================================="
  elif [[ "$FLAGS" == "--snapshot" || "$FLAGS" == "-s" ]] ; then
    if [[ ! "$HPTS" ]] ; then
      echo "No [snapshot ID] indicated."
      echo ""
      restorer-help
      exit
    fi
    echo -e "=========================================================================="
    echo -e "|- - - - - - - - > [ S T A R T I N G    R E S T O R E ] < - - - - - - - -|"
    echo -e "=========================================================================="
    echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""System:""$ENDCOLOR" "$(opsys)"
    if [[ "$HOST" ]] ; then
      echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOST"
    else
      echo -e "$YELLOW""Hostname:""$ENDCOLOR" "$HOSTNAME"
    fi
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$DESTINATION"
    else
      echo -e "$YELLOW""Backup Destination:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    echo -e "--------------------------------------------------------------------------"
    if [[ "$DESTINATION" ]] ; then
      echo -e "$YELLOW""Restoring snapshot ID ["$HPTS"] from:""$ENDCOLOR" "$DESTINATION..."
    else
      echo -e "$YELLOW""Restoring snapshot ID ["$HPTS"] from:""$ENDCOLOR" "$RESTIC_REPO"
    fi
    restic restore "$HPTS" --target "$RESTIC_RESTORE" --verify
    echo -e "--------------------------------------------------------------------------"
    echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$YELLOW""Duration:""$ENDCOLOR" "$(duration)"
    echo -e "=========================================================================="
    echo -e "| - - - - - - - > [ R E S T O R E    C O M P L E T E D ] <  -- - - - - - |"
    echo -e "=========================================================================="
  else
    echo "Invalid flag ["$FLAGS"]..."
    echo ""
    restorer-help
    exit
  fi  
}

function unlocker {
  if [[ "$FLAGS" ]] ; then
    if [[ "$FLAGS" == "--help" || "$FLAGS" == "-h" ]] ; then
      unlocker-help
      exit
    else
      echo "Invalid flag ["$FLAGS"]..."
      echo ""
      unlocker-help
      exit
    fi
  fi
  if [[ ! -e "$LOCK" ]]; then
    echo "No locks found..."
  else
    rm -rf "$LOCK"
    echo "Script unlocked..."
  fi
}

function time-start {
  echo -e "$YELLOW""Starting ["$CMD"] for ["$REPO"]...""$ENDCOLOR"
  echo -e "$YELLOW""Date and Time:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
  echo -e "--------------------------------------------------------------------------"
}

function time-end {
  echo -e "--------------------------------------------------------------------------"
  echo -e "$YELLOW""End:""$ENDCOLOR" "$(date +%a\ %b\ %d\ %Y\ %r)"
  echo -e "$YELLOW""Duration:""$ENDCOLOR" "$(duration)"
}

