function automatic {
  rescript-lock
  case "$LOGGING" in
    y|yes)
      logger
      ;;
  esac
  time-start
  # Backup and exclusions
  echo -e "$yellow""[Taking a Snapshot...]""$endcolor"
  restic backup $BACKUP_DIR --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host
  exclusions=$(grep -E -v -n -c '(^#|^\s*$|^\s*\t*#)' "$excludes")
  if [[ "$exclusions" -gt "0" ]] ; then
    echo -e "$yellow""There are $exclusions exclusion rules...""$endcolor"
  fi
  printf "%$((80/1))s\n" "" | tr ' ' -
  # Snapshot List
  echo -e "$yellow""[Snapshots List...]""$endcolor"
  restic snapshots
  # Check and Clean Repo Based on User's Policy
  if [[ -f "$config_dir/"$repo"-datefile" || "$CLEAN" -gt "0" ]]; then
    if [[ ! -f "$config_dir/"$repo"-datefile" ]] ; then
      touch "$config_dir/"$repo"-datefile"
    fi
    now_next
    if [[ "$now" -lt "$next" ]] ; then
      cleanup-next
    else 
      if [[ ! -z "$policies" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        restic forget "${policies[@]}"
        restic prune
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
        if [[ "$CLEAN" -gt "0" ]] ; then
          if [[ "$CLEAN" == "1" ]] ; then
            d="day"
          else
            d="days"
          fi
          echo -e "$yellow""[Done Cleaning; Next Cleanup and Check Will Be Done in $CLEAN $d...]""$endcolor"
          case "$(uname -s)" in
            Linux|GNU)
              date -d now+"$CLEAN"days > "$config_dir/"$repo"-datefile"
              ;;
            *)
              gdate -d now+"$CLEAN"days > "$config_dir/"$repo"-datefile"
              ;;
          esac
        fi
      fi
    fi
  else 
      if [[ ! -z "$policies" ]] ; then
        echo -e "$yellow""[Cleaning Repo...]""$endcolor"
        restic forget "${policies[@]}"
        restic prune
        echo -e "$yellow""[Checking for Errors in Repo...]""$endcolor"
        restic check --cleanup-cache
      fi
  fi
  # Stats
  printf "%$((80/1))s\n" "" | tr ' ' -
  echo -e "$yellow""[Original Size for Latest Snapshot...]""$endcolor"
  restic stats --host "" latest
  echo -e "$yellow""[Deduplicated Size for Latest Snapshot...]""$endcolor"
  restic stats --mode raw-data --host "" latest
  echo -e "$yellow""[Original Size for All Snapshots...]""$endcolor"
  restic stats
  echo -e "$yellow""[Deduplicated Size for All Snapshots...]""$endcolor"
  restic stats --mode raw-data
  # Time and Runtime
  time-end
  if [[ "$CLEAN" -gt "0" && -z "$policies" ]] ; then
    if [[ "$CLEAN" == "1" ]] ; then
      d="day"
    else
      d="days"
    fi
    echo "[rescript] noted that your CLEAN variable is $CLEAN, so [rescript] assumes that"
    echo "you want to perform a 'cleanup' (forget, prune and check) every $CLEAN $d but"
    echo "it can't execute it if you have not set the KEEP variables; please set your"
    echo "desired KEEP values in order to perform the 'cleanup' every $CLEAN $d. If you"
    echo "don't want [rescript] to 'cleanup' your repo automatically every $CLEAN $d,"
    echo "just leave the CLEAN variable blank in your cofiguration file and this"
    echo "message will not appear again."
    echo ""
    echo "For more info about this subject:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function backup {
  rescript-lock
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        backup-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      *)
        echo "Invalid flag ["$flags"]..."
        echo ""
        backup-help
        exit
        ;;
    esac
  fi
  time-start
  restic backup $BACKUP_DIR --verbose --exclude-caches --exclude-file="$excludes" $restic_tag $restic_host
  time-end
}

function changes {
  shopt -u nocasematch
  case "$flags" in
    -h|--help)
      changes-help
      exit
      ;;
    -H|--host|-p|--path|-T|--tag)
      if [[ ! "$hpts" ]] ; then
        case "$flags" in
          -H|--host)
            echo "No [host] indicated..."
            echo ""
            changes-help
            exit
            ;;
          -p|--path)
            echo "No [path] indicated..."
            echo ""
            changes-help
            exit
            ;;
          -T|--tag)
            echo "No [tag] indicated..."
            echo ""
            changes-help
            exit
            ;;
          *)
            echo "No valid option indicated..."
            echo ""
            changes-help
            exit
            ;;
        esac
      fi
      case "$flags" in
        -H|--host)
          restic_flag="--host"
          ;;
        -p|--path)
          restic_flag="--path"
          ;;
        -T|--tag)
          restic_flag="--tag"
          ;;
      esac
      case "$opt" in
        -m|--metadata)
          previous_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -4 | head -1 | awk '{print $1}')
          latest_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -3 | head -1 | awk '{print $1}')
          time-start
          restic diff "$previous_snapshot" "$latest_snapshot" --metadata
          time-end
          exit
          ;;
        *)
          previous_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -4 | head -1 | awk '{print $1}')
          latest_snapshot=$(restic snapshots --compact "$restic_flag" "$hpts" | tail -3 | head -1 | awk '{print $1}')
          time-start
          restic diff "$previous_snapshot" "$latest_snapshot"
          time-end
          exit
          ;;
      esac
      ;;
    -m|--metadata)
      if [[ "$hpts" ]] ; then
        case "$hpts" in
          -H|--host|-p|--path|-T|--tag)
            if [[ ! "$opt" ]] ; then
              case "$opt" in
                -H|--host)
                  echo "No [host] indicated..."
                  echo ""
                  changes-help
                  exit
                  ;;
                -p|--path)
                  echo "No [path] indicated..."
                  echo ""
                  changes-help
                  exit
                  ;;
                -T|--tag)
                  echo "No [tag] indicated..."
                  echo ""
                  changes-help
                  exit
                  ;;
                *)
                  echo "No valid option indicated..."
                  echo ""
                  changes-help
                  exit
                  ;;
              esac
            fi
            case "$hpts" in
              -H|--host)
                restic_flag="--host"
                ;;
              -p|--path)
                restic_flag="--path"
                ;;
              -T|--tag)
                restic_flag="--tag"
                ;;
            esac
            previous_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -4 | head -1 | awk '{print $1}')
            latest_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -3 | head -1 | awk '{print $1}')
            time-start
            restic diff "$previous_snapshot" "$latest_snapshot" --metadata
            time-end
            ;;
        esac
      elif [[ ! -z "$HOST" ]] ; then
        previous_snapshot=$(restic snapshots --compact --host "$HOST" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOST" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot" --metadata
        time-end
      else
        previous_snapshot=$(restic snapshots --compact --host "$HOSTNAME" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOSTNAME" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot" --metadata
        time-end
      fi
      exit
      ;;
    *)
      if [[ ! -z "$HOST" ]] ; then
        previous_snapshot=$(restic snapshots --compact --host "$HOST" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOST" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot"
        time-end
      else
        previous_snapshot=$(restic snapshots --compact --host "$HOSTNAME" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOSTNAME" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot"
        time-end
      fi
      exit
      ;;
  esac
}

function cleanup {
  rescript-lock
  if [[ "$flags" ]] ; then
    case "$flags" in
      -d|--dry-run)
        echo "This is just a test..."
        printf "%$((80/1))s\n" "" | tr ' ' -
        restic forget "${policies[@]}" --dry-run $opt
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo "Using [--dry-run] flag does not remove anything."
        exit
        ;;
      -e|--exec)
        time-start
        restic forget "${policies[@]}" $opt
        restic prune --cleanup-cache
        time-end
        exit
        ;;
      -h|--help)
        cleanup-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      -n|--next)
        if [[ -z "$CLEAN" || "$CLEAN" -lt "1" ]] ; then
          echo -e "$yellow""You have not indicated any policy for the CLEAN value...""$endcolor"
          echo "The scrip will run check, forget and prune every time it runs"
          echo "unless you change the CLEAN variable at the beginning of this script."
          echo "The number indicated in the CLEAN variable must be in days."
          echo "For more information about the usage check out the following link:"
          echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
          exit
        else
          cleanup-next
          exit
        fi
        ;;
      *)
        echo "Invalid flag ["$flags"]..."
        echo ""
        cleanup-help
        exit
        ;;
    esac
  fi
  if [[ ! -z "$policies" ]] ; then
    time-start
    restic forget "${policies[@]}"
    restic prune --cleanup-cache
    if [[ -f "$config_dir/"$repo"-datefile" || "$CLEAN" -gt "0" ]] ; then
      cleanup-next
    fi
    time-end
  else
    echo -e "$yellow""You have not indicated any policy value...""$endcolor"
    echo "If you want to use [cleanup] option you need to set the [KEEP] variables."
    echo "For more information about the Usage check out the following link:"
    echo "https://gitlab.com/sulfuror/rescript.sh/blob/master/README.md#usage"
  fi
}

function cleanup-next {
  if [[ ! -f "$config_dir/$repo-datefile" ]] ; then
    touch "$config_dir/$repo-datefile"
  fi
  now_next
  result=$((next-now))
  days=$((result / 86400))
  hours=$(((result / 3600) % 24))
  minutes=$(((result / 60) % 60))
  if [[ "$days" == "1" ]] ; then
    d="day"
  else
    d="days"
  fi
  if [[ "$hours" == "1" ]] ; then
    h="hour"
  else
    h="hours"
  fi
  if [[ "$minutes" == "1" ]] ; then
    m="minute"
  else
    m="minutes"
  fi
  if [[ "$days" -gt "0" ]] ; then
    if [[ "$hours" -gt "0" ]] ; then
      echo -e "$yellow""Next cleanup and check in $days $d, $hours $h and $minutes $m...""$endcolor"
    else
      echo -e "$yellow""Next cleanup and check in $days $d and $minutes $m...""$endcolor"
    fi
  elif [[ "$hours" -gt "0" ]] ; then
    echo -e "$yellow""Next cleanup and check in $hours $h and $minutes $m...""$endcolor"
  elif [[ "$minutes" -gt "0" ]] ; then
    echo -e "$yellow""Next cleanup and check in $minutes $m...""$endcolor"
  else
    echo -e "$yellow""Repo will be cleaned and checked in the next run...""$endcolor"
  fi
}

function logs {
  shopt -u nocasematch
  if [[ ! "$flags" ]] ; then
    echo "You have not indicated any option."
    echo ""
    logs-help
    exit
  fi
  case "$flags" in
    -c|--cat)
      if [[ "$logfile" ]] ; then
        cat $logs_dir/"$logfile"
      else
        echo "No log file indicated..."
        exit
      fi
      ;;
    -h|--help)
      logs-help
      exit
      ;;
    -L|--list)
      if ls $logs_dir/"$repo"-* 1> /dev/null 2>&1 ; then
        ls $logs_dir/ | grep -e "$repo"
        echo ""
        echo "Your logs are saved at $logs_dir"
      else
        echo "There are no log files to list for ["$repo"]."
      fi
      ;;
    -r|--remove)
      if ls $logs_dir/"$repo"-* 1> /dev/null 2>&1 ; then
        rm -rf $logs_dir/"$repo"-*
        echo "Log files removed for ["$repo"]."
      else
        echo "There are no log files to remove for ["$repo"]." 
      fi
      ;;
    *)
      echo "Invalid flag ["$flags"]..."
      echo ""
      logs-help
      exit
      ;;
  esac
}

function logger {
  if [[ ! "$cmd" ]] ; then
    log="$logs_dir/"$repo"-log-$(date +%Y-%m-%d-%H:%M).log"
  else
    log="$logs_dir/"$repo"-"$cmd"-log-$(date +%Y-%m-%d-%H:%M).log"
  fi
  exec > >(tee -a "$log") 2>&1
}

function mounter {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        mounter-help
        exit
        ;;
      *)
        echo "Invalid flag ["$flags"]..."
        echo ""
        mounter-help
        exit
        ;;
    esac
  fi
  rescript-lock
  mkdir "$rmount"
  restic mount "$rmount"
  rm -rf "$rmount"
}

function now_next {
  case "$(uname -s)" in
    Linux|GNU)
      now=$(date +"%s")
      next=$(date -f "$config_dir/"$repo"-datefile" "+%s")
      ;;
    *)
      now=$(gdate +"%s")
      next=$(gdate -f "$config_dir/"$repo"-datefile" "+%s")
      ;;
  esac
}

function random-check {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        random-check-help
        exit
        ;;
      -l|--log)
        echo "You must use [$flags] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      *)
        echo "Invalid flag ["$flags"]..."
        echo ""
        random-check-help
        exit
        ;;
    esac
  fi
  rescript-lock
  time-start
  restic check --read-data-subset $(($RANDOM % 10 + 1))/10
  time-end
}

function rescript-lock {
  if [ -e "$lock" ]; then
    echo "WARNING: ["$repo"] repo is already running..."
    echo "If you are sure "$repo" is not running, type"
    echo " "
    echo "  rescript "$repo" unlocker"
    echo " "
    echo "This will remove the lock for ["$repo"] repository."
    echo ""
    echo "Lock file info:"
    stat "$lock_dir/$repo.lock"
    exit
  fi
  touch "$lock"
  trap 'rm -rf "$lock"' INT QUIT TERM EXIT
}

function restorer {
  shopt -u nocasematch
  rescript-lock
  if [[ "$logger" ]] ; then
    case "$logger" in
      -l|--log)
        echo "You must use [$logger] only before any other command."
        echo ""
        logger-help
        exit
        ;;
      *)
        echo "Invalid flag ["$logger"]..."
        echo ""
        restorer-help
        exit
        ;;
    esac
  fi
  if [[ ! "$flags" ]] ; then
    echo "You have not indicated any option..."
    echo ""
    restorer-help
    exit
  fi
  case "$flags" in
    -h|--help)
      restorer-help
      exit
      ;;
    -H|--host)
      restic_restore="$HOME/restore-latest-host-"$hpts"_$(date +%s)"
      ;;
    -l|--log)
      echo "You must use [$flags] only before any other command."
      echo ""
      logger-help
      exit
      ;;
    -p|--path)
      restic_restore="$HOME/restore-latest-by-path_$(date +%s)"
      ;;
    -T|--tag)
      restic_restore="$HOME/restore-latest-tag-"$hpts"_$(date +%s)"
      ;;
    *)
      restic_restore="$HOME/restore-ID-"$hpts"_$(date +%s)"
      ;;
  esac
  case "$flags" in
    -H|--host|-p|--path|-T|--tag)
      if [[ ! "$hpts" ]] ; then
        if [[ "$flags" == "--host" || "$flags" == "-H" ]] ; then
          echo "No [host] indicated..."
          echo ""
          restorer-help
          exit
        elif [[ "$flags" == "--path" || "$flags" == "-p" ]] ; then
          echo "No [path] indicated..."
          echo ""
          restorer-help
          exit
        elif [[ "$flags" == "--tag" || "$flags" == "-t" ]] ; then
          echo "No [tag] indicated..."
          echo ""
          restorer-help
          exit
        fi
      fi      
      time-start
      if [[ "$DESTINATION" ]] ; then
        echo -e "$yellow""Restoring latest snapshot for ["$hpts"] from:""$endcolor" "$DESTINATION..."
      else
        echo -e "$yellow""Restoring latest snapshot for ["$hpts"] from:""$endcolor" "$RESTIC_REPO"
      fi
      case "$flags" in
        -H|--host)
          restic_flag="--host"
          ;;
        -T|--tag)
          restic_flag="--tag"
          ;;
        -p|--path)
          restic_flag="--path"
          ;;
        *)
          echo "Invalid flag ["$flags"]..."
          echo ""
          restorer-help
          exit
          ;;
      esac
      restic restore latest --target "$restic_restore" "$restic_flag" "$hpts" --verify
      time-end
      ;;
    -s|--snapshot)
      if [[ ! "$hpts" ]] ; then
        echo "No [snapshot ID] indicated."
        echo ""
        restorer-help
        exit
      fi
      time-start
      if [[ "$DESTINATION" ]] ; then
        echo -e "$yellow""Restoring snapshot ID ["$hpts"] from:""$endcolor" "$DESTINATION..."
      else
        echo -e "$yellow""Restoring snapshot ID ["$hpts"] from:""$endcolor" "$RESTIC_REPO"
      fi
      restic restore "$hpts" --target "$restic_restore" --verify
      time-end
      ;;
    *)
      echo "Invalid flag ["$flags"]..."
      echo ""
      restorer-help
      exit
      ;;
  esac
}

function time-start {
  if [[ ! "$cmd" ]] ; then
    title="S T A R T I N G    B A C K U P"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
    echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""System:""$endcolor" "$(opsys)"
    if [[ "$HOST" ]] ; then
      echo -e "$yellow""Hostname:""$endcolor" "$HOST"
    else
      echo -e "$yellow""Hostname:""$endcolor" "$HOSTNAME"
    fi
    if [[ "$DESTINATION" ]] ; then
      echo -e "$yellow""Backup Destination:""$endcolor" "$DESTINATION"
    else
      echo -e "$yellow""Backup Destination:""$endcolor" "$RESTIC_REPO"
    fi
    printf "%$((80/1))s\n" "" | tr ' ' -
  fi
  if [[ "$cmd" ]] ; then 
    case "$cmd" in
      backup|checkout|cleanup|restorer)
        if [[ "$cmd" == "backup" ]] ; then
          title="S T A R T I N G    B A C K U P"
        elif [[ "$cmd" == "checkout" ]] ; then
          title="S T A R T I N G    C H E C K O U T"
        elif [[ "$cmd" == "cleanup" ]] ; then
          title="S T A R T I N G    C L E A N U P"
        elif [[ "$cmd" == "restorer" ]] ; then
          title="S T A R T I N G    R E S T O R E R"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' =
        printf "%$(((80 + ${#title}) / 2))s\n" "$title"
        printf "%$((80/1))s\n" "" | tr ' ' =
        echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""System:""$endcolor" "$(opsys)"
        if [[ "$HOST" ]] ; then
          echo -e "$yellow""Hostname:""$endcolor" "$HOST"
        else
          echo -e "$yellow""Hostname:""$endcolor" "$HOSTNAME"
        fi
        if [[ "$DESTINATION" ]] ; then
          echo -e "$yellow""Backup Destination:""$endcolor" "$DESTINATION"
        else
          echo -e "$yellow""Backup Destination:""$endcolor" "$RESTIC_REPO"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' -
        ;;
      *)
        echo -e "$yellow""Starting ["$cmd"] for ["$repo"]...""$endcolor"
        echo -e "$yellow""Date and Time:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        printf "%$((80/1))s\n" "" | tr ' ' -
        ;;
    esac
  fi
}

function time-end {
  if [[ ! "$cmd" ]] ; then
    title="B A C K U P    E N D E D"
    printf "%$((80/1))s\n" "" | tr ' ' -
    echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""Duration:""$endcolor" "$(duration)"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
  fi
  if [[ "$cmd" ]] ; then
    case "$cmd" in
      backup|checkout|cleanup|restorer)
        if [[ "$cmd" == "backup" ]] ; then
          title="B A C K U P    E N D E D"
        elif [[ "$cmd" == "checkout" ]] ; then
          title="C H E C K O U T    E N D E D"
        elif [[ "$cmd" == "cleanup" ]] ; then
          title="C L E A N U P    E N D E D"
        elif [[ "$cmd" == "restorer" ]] ; then
          title="R E S T O R E R    E N D E D"
        fi
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""Duration:""$endcolor" "$(duration)"
        printf "%$((80/1))s\n" "" | tr ' ' =
        printf "%$(((80 + ${#title}) / 2))s\n" "$title"
        printf "%$((80/1))s\n" "" | tr ' ' =
        ;;
      *)
        printf "%$((80/1))s\n" "" | tr ' ' -
        echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
        echo -e "$yellow""Duration:""$endcolor" "$(duration)"
        ;;
    esac
  fi
}

function unlocker {
  if [[ "$flags" ]] ; then
    case "$flags" in
      -h|--help)
        unlocker-help
        exit
        ;;
      *)
        echo "Invalid flag ["$flags"]..."
        echo ""
        unlocker-help
        exit
        ;;
    esac
  fi
  if [[ ! -e "$lock" ]]; then
    echo "No locks found..."
  else
    rm -rf "$lock"
    echo "Script unlocked..."
  fi
}

