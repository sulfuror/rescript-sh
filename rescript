  printf " %-20s \n" "$title"
  echo "======================"
  echo " [1] Back to Main Menu"
  echo " [2] Exit             "
  echo "----------------------"
  ls "$config_dir" | grep -e "$pattern" | sed -e "s/$sedpat//"
