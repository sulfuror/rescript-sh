yellow="\033[33m"
endcolor="\033[0m"

# Rescript directories and files
rescript_dir="$HOME/.rescript"
config_dir="$HOME/.rescript/config"
lock_dir="$HOME/.rescript/lock"
logs_dir="$HOME/.rescript/logs"
excludes="$config_dir/$1-exclusions"
lock="$HOME/.rescript/lock/$1.lock"
rmount="$HOME/$1-repo-$(date +%s)"
repo="$1"

shopt -s nocasematch
trap ctrl_c INT

function ctrl_c {
  echo ""
  echo "** Proccess interrupted **"
  echo ""
  exit
}

# Create a rescript directories if they are not present
if [[ ! -d "$rescript_dir" ]]; then
  mkdir -p "$rescript_dir"
fi
if [[ ! -d "$config_dir" ]]; then
  mkdir -p "$config_dir"
fi
if [[ ! -d "$lock_dir" ]]; then
  mkdir -p "$lock_dir"
fi
if [[ ! -d "$logs_dir" ]]; then
  mkdir -p "$logs_dir"
fi
# Create "editor" file if not present
if [[ ! -f "$config_dir/.editor" ]] ; then
  touch "$config_dir/.editor"
fi
rescript_editor="$(cat "$config_dir/.editor")"
# Set PATH so it includes user's private bin if it exists (cron jobs may require this)
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

function opsys {
  case "$(uname -s)" in
    Linux|GNU)
      if [[ "$(uname -o)" = "Android" ]] ; then
        os="$(uname -o)"
        os_vers="$(getprop ro.build.version.release)"
        echo -e "$os" "$os_vers"
      else
        lsb_release -ds
      fi
      ;;
    FreeBSD|NetBSD|OpenBSD)
      uname -rs
      ;;
    Darwin)
      os="$(sw_vers -productName)"
      os_vers="$(sw_vers -productVersion)"
      echo -e "$os" "$os_vers"
      ;;
    *)
      echo -e "Unknown OS"
      ;;
  esac
}

function duration {
  d="$((SECONDS/60/60/24))"
  h="$((SECONDS/60/60%24))"
  m="$((SECONDS/60%60))"
  s="$((SECONDS%60))"
  if [[ "$d" = "1" ]] ; then
    days="day"
  else
    days="days"
  fi
  if [[ "$h" = "1" ]] ; then
    hrs="hour"
  else
    hrs="hours"
  fi
  if [[ "$m" = "1" ]] ; then
    min="minute"
  else
    min="minutes"
  fi
  if [[ "$s" = "1" ]] ; then
    sec="second"
  else
    sec="seconds"
  fi
  if [[ "$d" -gt "0" ]] ; then
    if [[ "$h" -gt "0" ]] ; then
      if [[ "$m" -gt "0" ]] ; then
        if [[ "$s" -gt "0" ]] ; then
          echo "$d $days, $h $hrs, $m $min and $s $sec"
        else
          echo "$d $days, $h $hrs and $m $min"
        fi
      else
        if [[ "$s" -gt "0" ]] ; then
          echo "$d $days, $h $hrs and $s $sec"
        else
          echo "$d $days and $h $hrs"
        fi
      fi
    else
      if [[ "$m" -gt "0" ]] ; then
        if [[ "$s" -gt "0" ]] ; then
          echo "$d $days, $m $min and $s $sec"
        else
          echo "$d $days and $m $min"
        fi
      else
        if [[ "$s" -gt "0" ]] ; then
          echo "$d $days and $s $sec"
        else
          echo "$d $days"
        fi
      fi
    fi
  elif [[ "$h" -gt "0" ]] ; then
    if [[ "$m" -gt "0" ]] ; then
      if [[ "$s" -gt "0" ]] ; then
        echo "$h $hrs, $m $min and $s $sec"
      else
        echo "$h $hrs and $m $min"
      fi
    else
      if [[ "$s" -gt "0" ]] ; then
        echo "$h $hrs and $s $sec"
      else
        echo "$h $hrs"
      fi
    fi
  elif [[ "$m" -gt "0" ]] ; then
    if [[ "$s" -gt "0" ]] ; then
      echo "$m $min and $s $sec"
    else
      echo "$m $min"
    fi
  else
    if [[ "$s" -gt "0" ]] ; then
      echo "$s $sec"
    else
      echo "Well, that was too fast!"
    fi
  fi
}
