                ;;
              -p|--path)
                if [[ ! "$opt" ]] ; then
                  echo "No [path] indicated..."
                  echo ""
                  changes-help
                  exit
                elif [[ "$(restic snapshots --compact --path "$opt" | tail -1 | awk '{print $1}')" = "0" ]] ; then
                  echo "There is no snapshot with [$opt] path in your repository."
                  exit
                fi
                restic_flag="--path"
                ;;
              -T|--tag)
                if [[ ! "$opt" ]] ; then
                  echo "No [tag] indicated..."
                  echo ""
                  changes-help
                  exit
                elif [[ "$(restic snapshots --compact --tag "$opt" | tail -1 | awk '{print $1}')" = "0" ]] ; then
                  echo "There is no [$opt] tag in your repository."
                  exit
                fi
                restic_flag="--tag"
                ;;
            esac
            previous_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -4 | head -1 | awk '{print $1}')
            latest_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -3 | head -1 | awk '{print $1}')
            time-start
            restic diff "$previous_snapshot" "$latest_snapshot" --metadata
            time-end
            ;;
            [a-z]*|-*|--*)
              echo "Invalid option [$hpts]..."
              echo ""
              changes-help
              exit
              ;;
            *)
              previous_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -4 | head -1 | awk '{print $1}')
              latest_snapshot=$(restic snapshots --compact "$restic_flag" "$opt" | tail -3 | head -1 | awk '{print $1}')
              time-start
              restic diff "$previous_snapshot" "$latest_snapshot" --metadata
              time-end
            ;;
        esac
      elif [[ ! -z "$HOST" ]] ; then
        previous_snapshot=$(restic snapshots --compact --host "$HOST" | tail -4 | head -1 | awk '{print $1}')
        latest_snapshot=$(restic snapshots --compact --host "$HOST" | tail -3 | head -1 | awk '{print $1}')
        time-start
        restic diff "$previous_snapshot" "$latest_snapshot" --metadata
        time-end
