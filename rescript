function opsys {
  OS_NAME="$(uname -s)"
  if [[ "$OS_NAME" == "Linux" || "$OS_NAME" == "Linux" ]] ; then
    echo -e "$(lsb_release -ds)"
  elif [[ "$OS_NAME" == "FreeBSD"* ]] ; then
    echo -e "$(uname -rs)"
  elif [[ "$OS_NAME" == "Darwin"* ]] ; then
    OS="$(sw_vers -productName)"
    OS_VERS="$(sw_vers -productVersion)"
    echo -e "$OS $OS_VERS"
  fi
}

function duration {
  D="$((SECONDS/60/60/24))"
  H="$((SECONDS/60/60%24))"
  M="$((SECONDS/60%60))"
  S="$((SECONDS%60))"
  if [[ "$D" == "1" ]] ; then
    DAYS="day"
  else
    DAYS="days"
  fi
  if [[ "$H" == "1" ]] ; then
    HRS="hour"
  else
    HRS="hours"
  fi
  if [[ "$M" == "1" ]] ; then
    MIN="minute"
  else
    MIN="minutes"
  fi
  if [[ "$S" == "1" ]] ; then
    SEC="second"
  else
    SEC="seconds"
  fi
  if [[ "$D" -gt "0" ]] ; then
    echo "$D $DAYS $H $HRS $M $MIN and $S $SEC"
  elif [[ "$H" -gt "0" ]] ; then
    echo "$H $HRS $M $MIN and $S $SEC"
  elif [[ "$M" -gt "0" ]] ; then
    echo "$M $MIN and $S $SEC"
  else
    echo "$S $SEC"
  fi
}
