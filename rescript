# ============================================================== #
yellow="\033[33m"
endcolor="\033[0m"

# Rescript directories and files
rescript_dir="$HOME/.rescript"
config_dir="$HOME/.rescript/config"
lock_dir="$HOME/.rescript/lock"
logs_dir="$HOME/.rescript/logs"
excludes="$config_dir/$1-exclusions"
lock="$HOME/.rescript/lock/$1.lock"
rmount="$HOME/$1-repo-$(date +%s)"
repo="$1"

if [[ -d "/tmp" ]] ; then
  tmp_dir="/tmp"
else
  tmp_dir="$TMPDIR"
fi

declare -a error_message

function report_errors {
  if [[ ! -z "$HOST" ]] ; then
    error_host="$HOST"
  else
    error_host="$(hostname)"
  fi
  if [[ "${error_message}" ]] ; then
    echo ""
    echo -e "WARNING!"
    echo -e "${error_message}"
    if [[ ! -z "$EMAIL" ]] ; then
      if [[ "$(which mail)" ]] ; then
        if [[ ! -t 1 ]] ; then
          if [[ "$log" ]] ; then
            logmessage=$(echo -e "\nCheck log for more info: $log")
          fi
          echo -e "Hostname: $error_host" "\nRepository Name: $repo" "\nDate: $(date)""\n" "\nCommand error:" "\n${error_message}" "\n" "$logmessage" | mail -s "rescript: there was an error with [$repo] repository!" $EMAIL
        fi
      else
        echo "[rescript] can't send emails; install [mailutils] package to do so."
      fi
    fi
  fi
}

function latest_error {
  exec 6>&-
  if [[ "$cmd_error" != "0" ]] ; then
    if [[  ! -z "$rest_cmd" ]] ; then
      error_message+="$(echo -e "[$rest_cmd] failed with exit code $cmd_error")"
      report_errors
      time_end
      exit "$cmd_error"
    elif [[ "$(echo $latest_cmd | awk '{print $1}')" = "restic" ]] ; then
      error_message+="$(echo -e "[$(echo $latest_cmd | awk '{print $2}')] failed with exit code $cmd_error")"
      report_errors
      time_end
      exit "$cmd_error"
    else
      error_message+="$(echo -e "[$(echo $latest_cmd | awk '{print $1}')] failed with exit code $cmd_error")"
      report_errors
      time_end
      exit "$cmd_error"
    fi
  fi
}

shopt -s nocasematch
trap ctrl_c INT

function ctrl_c {
  echo ""
  echo "################ Proccess interrupted ################"
  echo ""
  exit 130
}

# Create a rescript directories if they are not present
if [[ ! -d "$rescript_dir" ]]; then
  mkdir -p "$rescript_dir"
fi
if [[ ! -d "$config_dir" ]]; then
