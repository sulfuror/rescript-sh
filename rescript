function time_end {
  if [[ ! "$cmd" ]] ; then
    title="B A C K U P    E N D E D"
    printf "%$((80/1))s\n" "" | tr ' ' -
    echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
    echo -e "$yellow""Duration:""$endcolor" "$(duration)"
    printf "%$((80/1))s\n" "" | tr ' ' =
    printf "%$(((80 + ${#title}) / 2))s\n" "$title"
    printf "%$((80/1))s\n" "" | tr ' ' =
  fi
  if [[ "$cmd" ]] ; then
    if [[ "$time_flag" = "true" ]] ; then
      printf "%$((80/1))s\n" "" | tr ' ' -
      echo -e "$yellow""End:""$endcolor" "$(date +%a\ %b\ %d\ %Y\ %r)"
      echo -e "$yellow""Duration:""$endcolor" "$(duration)"
    fi
  fi
}

function unlocker {
  if [[ ! -e "$lock" ]]; then
    echo "No locks found..."
  else
    rm -rf "$lock"
    echo "Script unlocked..."
  fi
}

